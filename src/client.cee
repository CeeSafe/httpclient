// The client: prepared requests, the per-origin pool of connections, and the response that lends a connection's
// buffers and gives the connection back when it is dropped.
//
// A client belongs to one thread: its pool is a `RefCell`, not a lock, and concurrent tasks of that thread share it.
// A program with several worker threads makes a client for each.
import web_core;
import web_transport;
import web_tls;

/// A request to send, any number of times: its method, URL and fields, checked and encoded once.
@noncopy
public struct Request {
    private verb: Method;
    private text: Vector<u8>;
    private parts: UrlParts;
    /// The fields as they go on the wire: `name: value\r\n` each.
    private fields: Vector<u8>;
    /// The same fields as an HPACK block for HTTP/2, encoded when they were added.
    private packed: Vector<u8>;

    /// The URL's parts, and the request's fields as lines (`name: value\r\n` each): what another transport
    /// (httpclient3) needs to send it.
    public fn urlParts(borrow this) -> UrlParts => this.parts;

    public fn fieldLines(borrow this) -> Slice<u8> => this.fields.view();

    /// A request for `url`, an absolute `http://` or `https://` URL.
    public fn create(method: Method, url: StringView) -> Result<Request, HttpError> {
        let parts = match (UrlParts.parse(url.bytes())) {
            Some(p) => p,
            null => { return Err(HttpError.BadUrl); },
        };
        var text = Vector<u8>.create();
        match (text.extend(url.bytes())) {
            Ok() => {}
            Err(_) => { return Err(HttpErrors.noMemory()); }
        }
        return Ok(
            Request {
                verb: method,
                text: text,
                parts: parts,
                fields: Vector<u8>.create(),
                packed: Vector<u8>.create(),
            },
        );
    }

    /// Adds a field. `BadRequest` for a name that is not a token, a value with CR, LF or NUL or with whitespace at
    /// an end, and for `host`, `content-length` and `transfer-encoding`, which the client writes.
    public fn header(borrow mut this, name: StringView, value: StringView) -> Result<void, HttpError> {
        let n = name.bytes();
        let v = value.bytes();
        if (!isFieldName(n) || !isFieldValue(v) || n.equalsIgnoreAsciiCase("host".bytes()) ||
            n.equalsIgnoreAsciiCase("content-length".bytes()) || n.equalsIgnoreAsciiCase("transfer-encoding".bytes())) {
            return Err(HttpError.BadRequest);
        }
        match (this.append(n, v)) {
            Ok() => { return Ok(); }
            Err(_) => { return Err(HttpErrors.noMemory()); }
        }
    }

    fn append(borrow mut this, name: Slice<u8>, value: Slice<u8>) -> Result<void, AllocError> {
        this.fields.reserve(name.length + value.length + 4)?;
        this.fields.extend(name)?;
        this.fields.extend(": ".bytes())?;
        this.fields.extend(value)?;
        this.fields.extend("\r\n".bytes())?;
        return packField(mut this.packed, name, value);
    }

    /// The request's method.
    public fn method(borrow this) -> Method => this.verb;

    /// The request's URL.
    public fn url(borrow this) -> Slice<u8> => this.text.view();
}

/// An origin's connections that wait for a request, newest last.
struct Origin {
    secure: bool;
    port: u16;
    host: Vector<u8>;
    idle: Vector<Box<Connection>>;
    /// What the origin speaks, once a connection has shown it: 0 not known yet, 1 HTTP/1.1, 2 HTTP/2.
    protocol: u8;
    /// HTTP/3 as the origin advertised it (`Alt-Svc`): the UDP port (0: not advertised) and until when (`Timer.now`).
    h3Port: u16;
    h3Until: u64;
    /// HTTP/3 failed: not to be tried again before this time.
    h3BadUntil: u64;
    /// The requests-in-flight semaphore, a token per free place: one channel, or none without a limit.
    slots: Vector<Channel<u8>>;
    /// One token: who holds it may dial the origin's next HTTP/2 connection, so requests that start together
    /// share one connection instead of dialing one each. One channel, or none for a client without HTTP/2.
    gate: Vector<Channel<u8>>;
}

struct Origins {
    list: Vector<Origin>;
    closed: bool;
    /// Connections for the next dials, in order, instead of the network (tests).
    scripted: Vector<MockTransport>;
    /// A connection was scripted: when they run out a dial fails, so a test never reaches the network.
    offline: bool;
}

/// A place among an origin's requests in flight; dropping it frees the place.
struct Permit {
    slot: Channel<u8>?;

    drop {
        match (borrow this.slot) {
            Some(s) => { let freed = s.trySend(0); }
            null => {}
        }
    }
}

/// An HTTP client. Over HTTP/1.1, connections are kept per origin and reused, one request at a time on each; over
/// HTTP/2, one connection carries an origin's requests at once.
public struct Client {
    private options: ClientOptions;
    private tls: TlsConfig?;
    private origins: RefCell<Origins>;
    /// The places for HTTP/2 connections, made with the client and never moved: a response refers to its
    /// session by index.
    private sessions: Vector<H2Session>;
    /// The decompressor's tables, shared by every response of the client.
    private inflater: RefCell<Inflater>;
    /// The cookies servers have set, when the client keeps them (`ClientOptions.cookies`).
    private jar: RefCell<CookieJar>;
    /// The responses the client has kept (`ClientOptions.cacheBytes`).
    private cache: RefCell<ResponseCache>;
    private counters: RefCell<ClientStats>;
    /// HTTP/3, if the client was given a way to speak it (`withHttp3`).
    private http3: (Box<dyn Http3Transport>)?;
    /// The proxy the connections go through, if one was set.
    private proxy: Proxy?;

    /// A client for `http://` URLs; `https://` URLs fail with `NoTls`.
    public fn create(options: ClientOptions) -> Client => Client {
        options: options,
        tls: null,
        origins: RefCell<Origins>.create(
            Origins {
                list: Vector<Origin>.create(),
                closed: false,
                scripted: Vector<MockTransport>.create(),
                offline: false,
            },
        ),
        sessions: sessionsFor(options),
        inflater: RefCell<Inflater>.create(Inflater.create()),
        jar: RefCell<CookieJar>.create(CookieJar.create()),
        cache: RefCell<ResponseCache>.create(ResponseCache.create(options.cacheBytes)),
        counters: RefCell<ClientStats>.create(
            ClientStats {
                requests: 0,
                responses: 0,
                errors: 0,
                cached: 0,
                retries: 0,
                connections: 0,
                overHttp3: 0,
                totalMs: 0,
            },
        ),
        http3: null,
        proxy: null,
    };

    /// A client that also makes `https://` connections with `tls` (a web_tls `TlsConfig.client()` with its trust
    /// set). The ALPN protocols `tls` offers choose the version: with `h2` among them, a server that picks it is
    /// spoken to over HTTP/2.
    public fn withTls(options: ClientOptions, tls: TlsConfig) -> Client => Client {
        options: options,
        tls: Some(tls),
        origins: RefCell<Origins>.create(
            Origins {
                list: Vector<Origin>.create(),
                closed: false,
                scripted: Vector<MockTransport>.create(),
                offline: false,
            },
        ),
        sessions: sessionsFor(options),
        inflater: RefCell<Inflater>.create(Inflater.create()),
        jar: RefCell<CookieJar>.create(CookieJar.create()),
        cache: RefCell<ResponseCache>.create(ResponseCache.create(options.cacheBytes)),
        counters: RefCell<ClientStats>.create(
            ClientStats {
                requests: 0,
                responses: 0,
                errors: 0,
                cached: 0,
                retries: 0,
                connections: 0,
                overHttp3: 0,
                totalMs: 0,
            },
        ),
        http3: null,
        proxy: null,
    };

    /// A client as `withTls` makes, which also speaks HTTP/3 through `transport` (httpclient3's `Http3Pool`): for
    /// buffered requests (`get`, `send`) to `https` origins that advertise it with `Alt-Svc`, or to all of them with
    /// `ClientOptions.http3PriorKnowledge`. When HTTP/3 fails for an origin, its requests go over TCP again for
    /// `http3RetryMs`.
    public fn withHttp3(options: ClientOptions, tls: TlsConfig, transport: Box<dyn Http3Transport>) -> Client {
        var client = Client.withTls(options, tls);
        client.http3 = Some(transport);
        return client;
    }

    /// Sends the client's connections through `proxy` from now on. A SOCKS5 proxy carries everything; an HTTP proxy
    /// tunnels `https` origins and WebSockets (CONNECT) and is sent `http` requests with their whole URL, over
    /// HTTP/1.1. HTTP/3 is not used through a proxy. Set it before the first request: connections already open
    /// stay as they are.
    public fn setProxy(borrow mut this, proxy: Proxy) {
        this.proxy = Some(proxy);
    }

    /// Whether requests to an `http` origin go to an HTTP proxy with their whole URL (and so over HTTP/1.1).
    fn viaHttpProxy(borrow this, url: Slice<u8>, parts: borrow UrlParts) -> bool => match (borrow this.proxy) {
        Some(p) => p.kind is ProxyKind.Http && !parts.secure && p.covers(parts.host(url)),
        null => false,
    };

    /// Whether connections to `host` go through the client's proxy: it has one, and the host is not on its list of
    /// those to reach directly.
    fn proxyCovers(borrow this, host: Slice<u8>) -> bool => match (borrow this.proxy) {
        Some(p) => p.covers(host),
        null => false,
    };

    /// GET `url`; the whole response is read before this returns.
    public async fn get(borrow this, url: StringView) -> Result<Response, HttpError> {
        let text = url.bytes();
        let parts = match (UrlParts.parse(text)) {
            Some(p) => p,
            null => { return Err(HttpError.BadUrl); },
        };
        return await dispatch(this, Method.Get, text, parts, "".bytes(), "".bytes(), "".bytes(), true);
    }

    /// Sends `request` with `body` (empty for none); the whole response is read before this returns, and its body
    /// is `response.body()`.
    public async fn send(borrow this, request: borrow Request, body: Slice<u8>) -> Result<Response, HttpError> =>
        await dispatch(
            this,
            request.verb,
            request.text.view(),
            request.parts,
            request.fields.view(),
            request.packed.view(),
            body,
            true,
        );

    /// Sends `request` with `body`; this returns once the response's head has arrived, and the body is read with
    /// `response.read`. Read it to its end to keep the connection for the next request.
    public async fn open(borrow this, request: borrow Request, body: Slice<u8>) -> Result<Response, HttpError> =>
        await dispatch(
            this,
            request.verb,
            request.text.view(),
            request.parts,
            request.fields.view(),
            request.packed.view(),
            body,
            false,
        );

    /// Starts a request whose body is written piece by piece: `upload.write(bytes)` as often as needed, then
    /// `upload.finish()` for the response, which is buffered. With `length` the body is sent with that
    /// `content-length` and must be exactly as long; without, it is chunked over HTTP/1.1 and simply ends over
    /// HTTP/2. Nothing is kept of the body, so the request is not sent again: no redirect is followed, no retry made,
    /// and a pooled connection the server had closed is an error for the caller.
    public async fn upload(borrow this, request: borrow Request, length: u64?) -> Result<Upload, HttpError> =>
        await beginUpload(
            this,
            request.verb,
            request.text.view(),
            request.parts,
            request.fields.view(),
            request.packed.view(),
            length,
        );

    /// Opens a WebSocket (RFC 6455) with `request`: a GET for a `ws://` or `wss://` URL, whose fields may offer
    /// subprotocols (`Sec-WebSocket-Protocol`) and carry an `Origin` or credentials. `NotSwitched` with the status if
    /// the server answers otherwise. Over TLS the connection must speak HTTP/1.1: with a `TlsConfig` whose ALPN lets
    /// the server pick `h2`, it is `NotSwitched(0)`.
    public async fn webSocket(
        borrow this,
        request: borrow Request,
        options: WebSocketOptions,
    ) -> Result<WebSocket, HttpError> {
        if (!(request.verb is Method.Get)) {
            return Err(HttpError.BadRequest);
        }
        if (request.parts.secure && this.tls == null) {
            return Err(HttpError.NoTls);
        }
        var key = [0u8; 16];
        match (Random.fill(mut key[..])) {
            Ok() => {}
            Err(e) => { return Err(HttpError.Net(NetError.Io(e))); }
        }
        return await this.webSocketWithKey(request, options, key[..]);
    }

    /// `webSocket` with the handshake's key given (tests: a scripted server cannot answer a random one).
    async fn webSocketWithKey(
        borrow this,
        request: borrow Request,
        options: WebSocketOptions,
        key: Slice<u8>,
    ) -> Result<WebSocket, HttpError> {
        let url = request.text.view();
        let fields = request.fields.view();
        let parts = request.parts;
        if (options.handshakeMs == 0) {
            return await openWebSocket(this, url, parts, fields, options, key);
        }
        return await Async.timeout(
            options.handshakeMs,
            HttpError.Net(NetError.TimedOut),
            async () => await openWebSocket(this, url, parts, fields, options, key),
        );
    }

    /// Closes the idle connections. Requests that start afterwards fail with `Closed`; responses still held close
    /// their connections when dropped.
    public fn close(borrow this) {
        var guard = this.origins.write();
        let o = guard.data();
        o.closed = true;
        for (i in 0..o.list.length) {
            o.list[i].idle.clear();
        }
        for (i in 0..this.sessions.length) {
            this.sessions[i].retire();
        }
    }

    /// What `origin` is known to speak: 0 not known yet, 1 HTTP/1.1, 2 HTTP/2.
    fn protocol(borrow this, origin: usize) -> u8 {
        let guard = this.origins.read();
        let o = guard.data();
        return o.list[origin].protocol;
    }

    /// The UDP port to try HTTP/3 on for `origin`, or null: it has not advertised it (and the client does not
    /// assume it), the advertisement has run out, or it failed lately.
    fn http3Port(borrow this, origin: usize, urlPort: u16) -> u16? {
        let guard = this.origins.read();
        let all = guard.data();
        let o = borrow all.list[origin];
        let now = Timer.now();
        if (now < o.h3BadUntil || this.proxyCovers(o.host.view())) {
            return null; // it failed lately, or a proxy is in the way: QUIC does not go through one
        }
        if (o.h3Port != 0 && now < o.h3Until) {
            return Some(o.h3Port);
        }
        return if (this.options.http3PriorKnowledge) Some(urlPort) else null;
    }

    /// HTTP/3 failed for `origin`: TCP for a while.
    fn http3Failed(borrow this, origin: usize) {
        var guard = this.origins.write();
        let o = guard.data();
        o.list[origin].h3BadUntil = Timer.now() + this.options.http3RetryMs;
    }

    /// Keeps what a response's `Alt-Svc` says about HTTP/3 on `origin`.
    fn noteAltSvc(borrow this, origin: usize, response: borrow Response) {
        if (this.http3 == null) {
            return;
        }
        let said = match (response.header("alt-svc")) {
            Some(value) => match (altSvcH3(value)) {
                Some(a) => a,
                null => { return; },
            },
            null => { return; },
        };
        var guard = this.origins.write();
        let o = guard.data();
        if (said.clear || said.maxAge == 0) {
            o.list[origin].h3Port = 0;
            return;
        }
        o.list[origin].h3Port = said.port;
        o.list[origin].h3Until = Timer.now().saturatingAdd(said.maxAge.saturatingMul(1000));
    }

    fn learned(borrow this, origin: usize, protocol: u8) {
        var guard = this.origins.write();
        let o = guard.data();
        o.list[origin].protocol = protocol;
    }

    /// Opens a stream for the request on an HTTP/2 connection to `origin` that has room: the session and the slot.
    fn openStream(
        borrow this,
        origin: usize,
        method: Method,
        url: Slice<u8>,
        parts: borrow UrlParts,
        packed: Slice<u8>,
        length: u64?,
        endStream: bool,
        buffered: bool,
        coded: bool,
        extra: Slice<u8>,
    ) -> Result<H2Place?, HttpError> {
        let now = Timer.now();
        for (i in 0..this.sessions.length) {
            let session = borrow this.sessions[i];
            if (!session.serves(origin)) {
                continue;
            }
            if (session.isIdleSince(now, this.options.idleMs)) {
                session.retire(); // the server has likely closed it too
                continue;
            }
            match (session.open(
                method,
                url,
                parts,
                packed,
                length,
                endStream,
                buffered,
                this.options.maxBodyBytes,
                coded,
                extra,
            )) {
                Ok(Some(slot)) => { return Ok(Some(H2Place { session: i, slot: slot })); }
                Ok(null) => {}
                Err(_) => { return Err(HttpErrors.noMemory()); }
            }
        }
        return Ok(null);
    }

    /// A session without a connection, for a new one.
    fn freeSession(borrow this) -> usize? {
        for (i in 0..this.sessions.length) {
            if (this.sessions[i].isFree()) {
                return Some(i);
            }
        }
        return null;
    }

    /// What the client has done so far.
    public fn stats(borrow this) -> ClientStats {
        let guard = this.counters.read();
        return *guard.data();
    }

    /// How many responses the cache holds, and forgetting them all.
    public fn cachedResponses(borrow this) -> usize {
        let guard = this.cache.read();
        return guard.data().entries.length;
    }

    public fn clearCache(borrow this) {
        var guard = this.cache.write();
        let cache = guard.data();
        cache.entries.clear();
        cache.bytes = 0;
    }

    /// How many cookies the client holds.
    public fn cookieCount(borrow this) -> usize {
        let guard = this.jar.read();
        return guard.data().cookies.length;
    }

    /// Forgets every cookie.
    public fn clearCookies(borrow this) {
        var guard = this.jar.write();
        guard.data().cookies.clear();
    }

    /// The `Cookie` field for a request to `url`, as an HTTP/1.1 line in `line` and as HPACK in `packed`; both stay
    /// empty when no cookie applies.
    fn cookiesFor(
        borrow this,
        url: Slice<u8>,
        parts: borrow UrlParts,
        line: borrow mut Vector<u8>,
        packed: borrow mut Vector<u8>,
    ) -> Result<void, AllocError> {
        var value = Vector<u8>.create();
        {
            var guard = this.jar.write();
            let jar = guard.data();
            if (jar.cookies.length == 0) {
                return Ok();
            }
            jar.collect(url, parts, Clock.now().seconds, mut value)?;
        }
        if (value.length == 0) {
            return Ok();
        }
        line.reserve(value.length + 10)?;
        line.extend("Cookie: ".bytes())?;
        line.extend(value.view())?;
        line.extend("\r\n".bytes())?;
        // Never indexed (RFC 7541 §7.1.3): a cookie is a credential.
        return hpackLiteral(mut packed, 32, "".bytes(), value.view(), true);
    }

    /// Stores what the response's `Set-Cookie` fields set, for the URL that answered. A cookie that cannot be kept
    /// for lack of memory is dropped.
    fn keepCookies(borrow this, response: borrow Response, url: Slice<u8>, parts: borrow UrlParts) {
        var guard = this.jar.write();
        let jar = guard.data();
        let now = Clock.now().seconds;
        for (i in 0..response.headerCount()) {
            if (response.name(i).equalsIgnoreAsciiCase("set-cookie".bytes())) {
                let stored = jar.store(response.value(i), url, parts, now);
            }
        }
    }

    /// How many connections wait in the pool.
    public fn idleConnections(borrow this) -> usize {
        let guard = this.origins.read();
        let o = guard.data();
        var n: usize = 0;
        for (i in 0..o.list.length) {
            n += o.list[i].idle.length;
        }
        return n;
    }

    /// The index of `url`'s origin, made if new.
    fn origin(borrow this, url: Slice<u8>, parts: borrow UrlParts) -> Result<usize, HttpError> {
        var guard = this.origins.write();
        let o = guard.data();
        if (o.closed) {
            return Err(HttpError.Closed);
        }
        let host = parts.host(url);
        for (i in 0..o.list.length) {
            let have = borrow o.list[i];
            if (have.port == parts.port && have.secure == parts.secure && have.host.length == host.length &&
                have.host.view().equalsIgnoreAsciiCase(host)) {
                return Ok(i);
            }
        }
        match (this.newOrigin(host, parts)) {
            Ok(made) => {
                match (o.list.push(made)) {
                    Ok() => { return Ok(o.list.length - 1); }
                    Err(_) => { return Err(HttpErrors.noMemory()); }
                }
            }
            Err(_) => { return Err(HttpErrors.noMemory()); }
        }
    }

    fn newOrigin(borrow this, host: Slice<u8>, parts: borrow UrlParts) -> Result<Origin, AllocError> {
        var name = Vector<u8>.create();
        name.extend(host)?;
        var slots = Vector<Channel<u8>>.create();
        if (this.options.maxPerOrigin > 0) {
            let tokens = Channel<u8>.create(this.options.maxPerOrigin)?;
            for (k in 0..this.options.maxPerOrigin) {
                let filled = tokens.trySend(0);
            }
            slots.push(tokens)?;
        }
        var gate = Vector<Channel<u8>>.create();
        if (this.sessions.length > 0) {
            let token = Channel<u8>.create(1)?;
            let filled = token.trySend(0);
            gate.push(token)?;
        }
        return Ok(Origin {
            secure: parts.secure,
            port: parts.port,
            host: name,
            idle: Vector<Box<Connection>>.create(),
            protocol: 0,
            h3Port: 0,
            h3Until: 0,
            h3BadUntil: 0,
            slots: slots,
            gate: gate,
        });
    }

    /// The origin's semaphore, if it has one.
    fn slots(borrow this, origin: usize) -> Channel<u8>? {
        let guard = this.origins.read();
        let o = guard.data();
        if (o.list[origin].slots.length == 0) {
            return null;
        }
        return Some(o.list[origin].slots[0].clone());
    }

    /// The origin's dial gate, if it has one.
    fn gate(borrow this, origin: usize) -> Channel<u8>? {
        let guard = this.origins.read();
        let o = guard.data();
        if (o.list[origin].gate.length == 0) {
            return null;
        }
        return Some(o.list[origin].gate[0].clone());
    }

    /// The origin's newest idle connection that has not been idle too long; older ones are closed.
    fn takeIdle(borrow this, origin: usize) -> Box<Connection>? {
        var guard = this.origins.write();
        let o = guard.data();
        let now = Timer.now();
        loop {
            let conn = match (o.list[origin].idle.pop()) {
                Some(c) => c,
                null => { return null; },
            };
            if (this.options.idleMs == 0 || now - conn.idleSince <= this.options.idleMs) {
                return Some(conn);
            }
        }
    }

    /// Takes a connection back after its response; closed instead if the pool is full or the client is closed.
    fn giveBack(borrow this, origin: usize, conn: Box<Connection>) {
        var guard = this.origins.write();
        let o = guard.data();
        if (o.closed || o.list[origin].idle.length >= this.options.maxIdlePerOrigin) {
            return;
        }
        var kept = conn;
        if (kept.buffer.length > this.options.maxKeptBuffer) {
            // One large response does not pin its buffer to the connection for good.
            var small = Vector<u8>.create();
            match (small.resize(this.options.bufferSize, 0)) {
                Ok() => {}
                Err(_) => { return; }
            }
            kept.buffer = small;
        }
        kept.idleSince = Timer.now();
        kept.reused = true;
        let pushed = o.list[origin].idle.push(kept);
    }

    /// A scripted connection waiting for a dial, if a test left one.
    fn scriptedDial(borrow this) -> MockTransport? {
        var guard = this.origins.write();
        let o = guard.data();
        if (o.scripted.length == 0) {
            return null;
        }
        return Some(o.scripted.remove(0));
    }

    /// Counts a connection opened.
    fn dialed(borrow this) {
        var guard = this.counters.write();
        let c = guard.data();
        c.connections += 1;
    }

    /// Whether the client dials only scripted connections.
    fn isOffline(borrow this) -> bool {
        let guard = this.origins.read();
        return guard.data().offline;
    }

    /// Makes the next dial use `mock` instead of the network (tests).
    fn script(borrow this, mock: MockTransport) -> Result<void, AllocError> {
        var guard = this.origins.write();
        let o = guard.data();
        o.offline = true;
        return o.scripted.push(mock);
    }
}

/// The client's HTTP/2 sessions: as many as the options ask for, or fewer if memory is short.
fn sessionsFor(options: ClientOptions) -> Vector<H2Session> {
    var sessions = Vector<H2Session>.create();
    if (options.http2Streams == 0) {
        return sessions;
    }
    for (i in 0..options.http2Connections) {
        match (H2Session.create(options.http2Streams, options)) {
            Ok(session) => {
                match (sessions.push(session)) {
                    Ok() => {}
                    Err(_) => { break; }
                }
            }
            Err(_) => { break; }
        }
    }
    return sessions;
}

/// A stream on an HTTP/2 connection: the session's index in the client, and the stream's slot in the session.
struct H2Place {
    session: usize;
    slot: usize;
}

/// Appends a field to `packed` as HPACK for a request (RFC 9113 §8.2): the name lowercase, credentials marked never
/// to be indexed, and the fields that describe an HTTP/1.1 connection left out.
fn packField(packed: borrow mut Vector<u8>, name: Slice<u8>, value: Slice<u8>) -> Result<void, AllocError> {
    var lower = Vector<u8>.withCapacity(name.length)?;
    for (b in name) {
        lower.push(if (b >= 'A' && b <= 'Z') b + 32 else b)?;
    }
    let n = lower.view();
    if (n == "connection".bytes() || n == "keep-alive".bytes() || n == "proxy-connection".bytes() ||
        n == "upgrade".bytes()) {
        return Ok();
    }
    if (n == "te".bytes() && !value.equalsIgnoreAsciiCase("trailers".bytes())) {
        return Ok();
    }
    let secret = n == "authorization".bytes() || n == "cookie".bytes() || n == "proxy-authorization".bytes();
    return hpackLiteral(mut packed, staticNameIndex(n), n, value, secret);
}

/// Whether the field lines of `fields` have one named `name` (lowercase).
fn namesField(fields: Slice<u8>, name: Slice<u8>) -> bool {
    var at: usize = 0;
    while (at < fields.length) {
        let rest = fields[at..];
        let end = rest.indexOfByte('\n') ?? rest.length;
        if (end > name.length && rest[name.length] == ':' && rest[0..name.length].equalsIgnoreAsciiCase(name)) {
            return true;
        }
        at += end + 1;
    }
    return false;
}

/// The field lines of `fields` (`name: value\r\n` each) as an HPACK block in `packed`.
fn packFields(fields: Slice<u8>, packed: borrow mut Vector<u8>) -> Result<void, AllocError> {
    packed.clear();
    var at: usize = 0;
    while (at < fields.length) {
        let rest = fields[at..];
        let end = rest.indexOfByte('\n') ?? rest.length;
        var line = rest[0..end];
        if (line.length > 0 && line[line.length - 1] == '\r') {
            line = line[0..line.length - 1];
        }
        match (line.indexOfByte(':')) {
            Some(colon) => { packField(mut packed, line[0..colon], line[colon + 1..].trim())?; }
            null => {}
        }
        at += end + 1;
    }
    return Ok();
}

/// One request from start to end, counted.
async fn dispatch<region c>(
    client: borrow(c) Client,
    method: Method,
    url: Slice<u8>,
    parts: UrlParts,
    fields: Slice<u8>,
    packed: Slice<u8>,
    body: Slice<u8>,
    buffered: bool,
) -> Result<Response<c>, HttpError> {
    let began = Timer.now();
    let result = await routed(client, method, url, parts, fields, packed, body, buffered);
    let ms = Timer.now() - began;
    match (borrow result) {
        Ok(response) => {
            {
                var guard = client.counters.write();
                let c = guard.data();
                c.requests += 1;
                c.totalMs += ms;
                c.responses += 1;
                if (response.fromCache()) {
                    c.cached += 1;
                }
            }
        }
        Err(_) => {
            {
                var guard = client.counters.write();
                let c = guard.data();
                c.requests += 1;
                c.totalMs += ms;
                c.errors += 1;
            }
        }
    }
    return result;
}

/// A request, and the requests its redirects ask for while `maxRedirects` allows (RFC 9110 §15.4). 303 becomes a GET
/// without the body (a HEAD stays one), and so do 301 and 302 after a POST; 307 and 308 repeat the request as it
/// was. A redirect to another origin loses the request's credentials, and one from https to http is not followed:
/// its response is returned as it is, like any redirect without a usable `Location`.
async fn routed<region c>(
    client: borrow(c) Client,
    method: Method,
    url: Slice<u8>,
    parts: UrlParts,
    fields: Slice<u8>,
    packed: Slice<u8>,
    body: Slice<u8>,
    buffered: bool,
) -> Result<Response<c>, HttpError> {
    let limit = client.options.maxRedirects;
    if (limit == 0) {
        return await cachedFetch(client, method, url, parts, fields, packed, body, buffered);
    }
    var verb = method;
    var text = Vector<u8>.create();
    var place = parts;
    var kept = Vector<u8>.create();
    var keptPacked = Vector<u8>.create();
    var filtered = false;
    var credentials = true;
    var content = true;
    var hops: u32 = 0;
    loop {
        let here = if (hops == 0) url else text.view();
        let lines = if (filtered) kept.view() else fields;
        let block = if (filtered) keptPacked.view() else packed;
        let payload = if (content) body else "".bytes();
        let response = await cachedFetch(client, verb, here, place, lines, block, payload, buffered)?;
        let status = response.status();
        if (!isRedirect(status)) {
            return Ok(response);
        }
        let location = match (response.header("location")) {
            Some(l) => l,
            null => { return Ok(response); },
        };
        var next = Vector<u8>.create();
        match (resolveLocation(here, place, location, mut next)) {
            Ok() => {}
            Err(_) => { return Err(HttpErrors.noMemory()); }
        }
        let target = match (UrlParts.parse(next.view())) {
            Some(p) => p,
            null => { return Ok(response); },
        };
        if (place.secure && !target.secure) {
            return Ok(response);
        }
        if (hops >= limit) {
            return Err(HttpError.TooManyRedirects);
        }
        let toGet =
            (status == 303 && !(verb is Method.Head)) || ((status == 301 || status == 302) && verb is Method.Post);
        if (toGet) {
            verb = Method.Get;
            content = false;
        }
        let sameOrigin = target.secure == place.secure && target.port == place.port &&
            target.host(next.view()).equalsIgnoreAsciiCase(place.host(here));
        if (!sameOrigin) {
            credentials = false;
        }
        if (!credentials || !content) {
            let made = filterFields(fields, credentials, content, mut kept);
            let both = if (made.isOk()) packFields(kept.view(), mut keptPacked) else made;
            match (both) {
                Ok() => {}
                Err(_) => { return Err(HttpErrors.noMemory()); }
            }
            filtered = true;
        }
        hops += 1;
        place = target;
        text = next;
    }
}

/// A response's fields as lines, `name: value\r\n` each, appended to `out`.
fn fieldLines(response: borrow Response, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    for (i in 0..response.headerCount()) {
        out.extend(response.name(i))?;
        out.extend(": ".bytes())?;
        out.extend(response.value(i))?;
        out.extend("\r\n".bytes())?;
    }
    return Ok();
}

/// A response made of a stored one: copies of its fields and body, which the response owns.
fn storedResponse<region c>(client: borrow(c) Client, entry: borrow CacheEntry) -> Result<Response<c>, HttpError> {
    var head = Vector<u8>.create();
    var spans = Vector<HeaderSpan>.create();
    var data = Vector<u8>.create();
    match (copyStored(entry, mut head, mut spans, mut data)) {
        Ok() => {}
        Err(_) => { return Err(HttpErrors.noMemory()); }
    }
    let filled = data.length;
    let decoded = entry.decoded;
    return Ok(Response {
        client: client,
        conn: null,
        origin: 0,
        permit: Permit { slot: null },
        viaH2: false,
        viaH3: false,
        h3Stream: 0,
        h3Open: false,
        session: 0,
        slot: 0,
        generation: 0,
        code: 200,
        head: head,
        spans: spans,
        data: data,
        filled: filled,
        streamed: false,
        decoded: decoded,
        cached: true,
        trailers: 0,
    });
}

/// Lays a stored response out as a response's own buffers: `:status` first, as over HTTP/2, then its fields.
fn copyStored(
    entry: borrow CacheEntry,
    head: borrow mut Vector<u8>,
    spans: borrow mut Vector<HeaderSpan>,
    data: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    head.extend(":status200".bytes())?;
    spans.push(HeaderSpan { nameStart: 0, nameEnd: 7, valueStart: 7, valueEnd: 10 })?;
    let fields = entry.fields.view();
    var at: usize = 0;
    while (at < fields.length) {
        let rest = fields[at..];
        let end = rest.indexOfByte('\n') ?? rest.length;
        var line = rest[0..end];
        if (line.length > 0 && line[line.length - 1] == '\r') {
            line = line[0..line.length - 1];
        }
        match (line.indexOfByte(':')) {
            Some(colon) => {
                let nameStart = head.length;
                head.extend(line[0..colon])?;
                let nameEnd = head.length;
                head.extend(line[colon + 1..].trim())?;
                spans.push(
                    HeaderSpan { nameStart: nameStart, nameEnd: nameEnd, valueStart: nameEnd, valueEnd: head.length },
                )?;
            }
            null => {}
        }
        at += end + 1;
    }
    return data.extend(entry.body.view());
}

/// A request through the client's cache (RFC 9111), when it has one: a buffered GET is answered from a stored
/// response that is still fresh; one that is stale and has a validator is asked about, and a 304 makes it fresh
/// again; a 200 is stored if it may be. Any other method goes to the network, and one that may change what is at the
/// URL forgets what was stored for it.
async fn cachedFetch<region c>(
    client: borrow(c) Client,
    method: Method,
    url: Slice<u8>,
    parts: UrlParts,
    fields: Slice<u8>,
    packed: Slice<u8>,
    body: Slice<u8>,
    buffered: bool,
) -> Result<Response<c>, HttpError> {
    let nothing = "".bytes();
    if (client.options.cacheBytes == 0) {
        return await resilient(client, method, url, parts, fields, packed, nothing, nothing, body, buffered);
    }
    if (!(method is Method.Get) || !buffered) {
        let response = await resilient(client, method, url, parts, fields, packed, nothing, nothing, body, buffered)?;
        let changes = match (method) {
            Method.Get => false,
            Method.Head => false,
            Method.Options => false,
            Method.Trace => false,
            _ => true,
        };
        if (changes && response.status() < 400) {
            var guard = client.cache.write();
            guard.data().remove(url);
        }
        return Ok(response);
    }
    var asked = CacheControl { noStore: false, noCache: false, maxAge: -1 };
    match (fieldValue(fields, "cache-control".bytes())) {
        Some(value) => { asked = cacheControl(value); }
        null => {}
    }
    match (fieldValue(fields, "pragma".bytes())) {
        Some(value) => {
            if (value.equalsIgnoreAsciiCase("no-cache".bytes())) {
                asked.noCache = true;
            }
        }
        null => {}
    }
    // A request that wants nothing stored, a part of the body, or asks its own conditions is not the cache's.
    if (asked.noStore || fieldValue(
        fields,
        "range".bytes(),
    ) != null || fieldValue(fields, "if-none-match".bytes()) != null ||
        fieldValue(fields, "if-modified-since".bytes()) != null) {
        return await resilient(client, method, url, parts, fields, packed, nothing, nothing, body, buffered);
    }
    let now = Clock.now().seconds;
    var more = Vector<u8>.create();
    var morePacked = Vector<u8>.create();
    {
        var guard = client.cache.write();
        let cache = guard.data();
        match (cache.find(url, fields)) {
            Some(i) => {
                if (!asked.noCache && cache.isFresh(i, now, asked.maxAge)) {
                    cache.touch(i);
                    return storedResponse(client, borrow cache.entries[i]);
                }
                let made = validators(cache.entries[i].fields.view(), mut more);
                let both = if (made.isOk()) packFields(more.view(), mut morePacked) else made;
                match (both) {
                    Ok() => {}
                    Err(_) => { return Err(HttpErrors.noMemory()); }
                }
            }
            null => {}
        }
    }
    let response = await resilient(
        client,
        method,
        url,
        parts,
        fields,
        packed,
        more.view(),
        morePacked.view(),
        body,
        buffered,
    )?;
    let status = response.status();
    var lost = false;
    if (status == 200 || (status == 304 && more.length > 0)) {
        var lines = Vector<u8>.create();
        match (fieldLines(response, mut lines)) {
            Ok() => {}
            Err(_) => { return Err(HttpErrors.noMemory()); }
        }
        var guard = client.cache.write();
        let cache = guard.data();
        if (status == 304) {
            // The stored response is still good: it is the answer, with the fields the 304 brought.
            match (cache.find(url, fields)) {
                Some(i) => {
                    match (cache.refresh(i, lines.view(), now)) {
                        Ok() => {}
                        Err(_) => { return Err(HttpErrors.noMemory()); }
                    }
                    cache.touch(i);
                    return storedResponse(client, borrow cache.entries[i]);
                }
                null => { lost = true; } // it left the cache while the question was out
            }
        } else {
            // A response that varies on the request's cookies is not kept when the jar chooses them: the request's
            // own fields do not show which were sent.
            let byCookie = client.options.cookies && variesOnCookie(lines.view());
            if (!byCookie) {
                let stored = cache.store(url, fields, lines.view(), response.body(), response.wasDecoded(), now);
            }
        }
    }
    if (lost) {
        return await resilient(client, method, url, parts, fields, packed, nothing, nothing, body, buffered);
    }
    return Ok(response);
}

/// Whether a response with these fields names `cookie` in its `vary`.
fn variesOnCookie(fields: Slice<u8>) -> bool {
    let names = match (fieldValue(fields, "vary".bytes())) {
        Some(v) => v,
        null => { return false; },
    };
    var at: usize = 0;
    while (at < names.length) {
        var end = at;
        while (end < names.length && names[end] != ',') {
            end += 1;
        }
        if (names[at..end].trim().equalsIgnoreAsciiCase("cookie".bytes())) {
            return true;
        }
        at = end + 1;
    }
    return false;
}

/// One request, sent again as the client's `RetryPolicy` allows: after a status that says "later" (the delay
/// `Retry-After` names, if it names one) or after the network failed, with a delay that doubles. Only a method that
/// is safe to repeat is sent again (RFC 9110 §9.2.2). The response returned is the last attempt's, whatever its
/// status.
async fn resilient<region c>(
    client: borrow(c) Client,
    method: Method,
    url: Slice<u8>,
    parts: UrlParts,
    fields: Slice<u8>,
    packed: Slice<u8>,
    more: Slice<u8>,
    morePacked: Slice<u8>,
    body: Slice<u8>,
    buffered: bool,
) -> Result<Response<c>, HttpError> {
    let policy = borrow client.options.retry;
    if (policy.attempts <= 1 || !Methods.idempotent(method)) {
        return await roundTrip(client, method, url, parts, fields, packed, more, morePacked, body, buffered);
    }
    var attempt: u32 = 0;
    loop {
        attempt += 1;
        let last = attempt >= policy.attempts;
        var waitMs: u64 = 0;
        match (await roundTrip(client, method, url, parts, fields, packed, more, morePacked, body, buffered)) {
            Ok(response) => {
                if (last || !policy.onStatus || !retryStatus(response.status())) {
                    return Ok(response);
                }
                waitMs = backoffMs(policy, attempt);
                match (response.header("retry-after")) {
                    Some(value) => {
                        match (retryAfterMs(value, Clock.now().seconds)) {
                            Some(asked) => { waitMs = if (asked > policy.maxMs) policy.maxMs else asked; }
                            null => {}
                        }
                    }
                    null => {}
                }
            }
            Err(e) => {
                if (last || !policy.onNetwork || !retryNetwork(e)) {
                    return Err(e);
                }
                waitMs = backoffMs(policy, attempt);
            }
        }
        if (waitMs > 0) {
            {
                var guard = client.counters.write();
                let c = guard.data();
                c.retries += 1;
            }
            match (await Timer.sleep(waitMs)) {
                Ok() => {}
                Err(e) => { return Err(HttpError.Net(NetErrors.fromAsync(e))); }
            }
        }
    }
}

/// One request and its response. Over HTTP/2 if the origin has a connection with room, or its next connection
/// turns out to speak it; else over HTTP/1.1, on a pooled connection if there is one. A request whose connection
/// had gone away is sent again on another when that is safe (`Connection.stale`, `H2Session.mayRetry`).
async fn roundTrip<region c>(
    client: borrow(c) Client,
    method: Method,
    url: Slice<u8>,
    parts: UrlParts,
    fields: Slice<u8>,
    packed: Slice<u8>,
    more: Slice<u8>,
    morePacked: Slice<u8>,
    body: Slice<u8>,
    buffered: bool,
) -> Result<Response<c>, HttpError> {
    if (parts.secure && client.tls == null) {
        return Err(HttpError.NoTls);
    }
    let origin = client.origin(url, parts)?;
    var permit = Permit { slot: null };
    match (client.slots(origin)) {
        Some(slots) => {
            match (await slots.recvAsync()) {
                Ok(Some(_)) => {}
                Ok(null) => { return Err(HttpError.Closed); }
                Err(e) => { return Err(HttpError.Net(NetErrors.fromAsync(e))); }
            }
            permit.slot = Some(slots);
        }
        null => {}
    }
    let options = borrow client.options;
    let head = method is Method.Head;
    let length: u64? = if (body.length > 0 || Methods.sendsLength(method)) Some(body.length as u64) else null;
    // HTTP/2 is possible when the client has sessions and the origin may speak it: https (by ALPN), or http by
    // prior knowledge.
    let mayH2 = client.sessions.length > 0 && (parts.secure || options.http2PriorKnowledge) && !client.viaHttpProxy(
        url,
        parts,
    );
    // A buffered response may come compressed when the client is to decompress it, unless the request says itself
    // what codings it takes.
    let coded = options.decompress && buffered && !namesField(fields, "accept-encoding".bytes());
    // The jar's cookies for this URL, as a field for each protocol, unless the request brings its own `Cookie`.
    var cookieLine = Vector<u8>.create();
    var cookiePacked = Vector<u8>.create();
    if (more.length > 0) {
        // The cache's questions about a stored response go with the request's own fields.
        let added = cookieLine.extend(more);
        let packedToo = if (added.isOk()) cookiePacked.extend(morePacked) else added;
        match (packedToo) {
            Ok() => {}
            Err(_) => { return Err(HttpErrors.noMemory()); }
        }
    }
    if (options.cookies && !namesField(fields, "cookie".bytes())) {
        match (client.cookiesFor(url, parts, mut cookieLine, mut cookiePacked)) {
            Ok() => {}
            Err(_) => { return Err(HttpErrors.noMemory()); }
        }
    }
    // To an HTTP proxy an `http` request goes with its whole URL, and the proxy's credentials.
    let absolute = client.viaHttpProxy(url, parts);
    if (absolute) {
        match (borrow client.proxy) {
            Some(p) => {
                match (p.authorization(mut cookieLine)) {
                    Ok() => {}
                    Err(_) => { return Err(HttpErrors.noMemory()); }
                }
            }
            null => {}
        }
    }
    // HTTP/3 first, for a buffered request to an origin that speaks it; any other way if that fails.
    if (parts.secure) {
        match (borrow client.http3) {
            Some(transport) => {
                match (client.http3Port(origin, parts.port)) {
                    Some(port) => {
                        var lines = Vector<u8>.create();
                        var built = lines.extend(fields);
                        if (built.isOk()) {
                            built = lines.extend(cookieLine.view());
                        }
                        if (built.isOk() && coded) {
                            built = lines.extend("Accept-Encoding: gzip, deflate\r\n".bytes());
                        }
                        match (built) {
                            Ok() => {}
                            Err(_) => { return Err(HttpErrors.noMemory()); }
                        }
                        var answer = Http3Answer.create();
                        var stream: u64 = 0;
                        var went: Result<void, Http3Failure> = Ok();
                        if (buffered) {
                            went = await transport.fetch(
                                method,
                                url,
                                parts,
                                port,
                                lines.view(),
                                body,
                                options.responseMs,
                                options.maxBodyBytes,
                                mut answer,
                            );
                        } else {
                            match (await transport.open(
                                method,
                                url,
                                parts,
                                port,
                                lines.view(),
                                body,
                                options.responseMs,
                                mut answer,
                            )) {
                                Ok(name) => { stream = name; }
                                Err(f) => { went = Err(f); }
                            }
                        }
                        match (went) {
                            Ok() => {
                                let filled = answer.body.length;
                                var response = Response {
                                    client: client,
                                    conn: null,
                                    origin: origin,
                                    permit: permit,
                                    viaH2: false,
                                    viaH3: true,
                                    h3Stream: 0,
                                    h3Open: false,
                                    session: 0,
                                    slot: 0,
                                    generation: 0,
                                    code: answer.status,
                                    head: answer.head,
                                    spans: answer.spans,
                                    data: answer.body,
                                    filled: filled,
                                    streamed: !buffered,
                                    decoded: false,
                                    cached: false,
                                    trailers: answer.trailers,
                                };
                                response.h3Stream = stream;
                                response.h3Open = !buffered;
                                {
                                    var guard = client.counters.write();
                                    let c = guard.data();
                                    c.overHttp3 += 1;
                                }
                                client.noteAltSvc(origin, response);
                                if (options.cookies) {
                                    client.keepCookies(response, url, parts);
                                }
                                if (options.decompress && buffered) {
                                    response.decode()?;
                                }
                                return Ok(response);
                            }
                            Err(f) => {
                                client.http3Failed(origin);
                                if (!f.unsent && !Methods.idempotent(method)) {
                                    return Err(f.error);
                                }
                            }
                        }
                    }
                    null => {}
                }
            }
            null => {}
        }
    }
    var attempts: u32 = 0;
    loop {
        attempts += 1;
        let carried = await connect(
            client,
            origin,
            method,
            url,
            parts,
            packed,
            length,
            body.length == 0,
            buffered,
            coded,
            cookiePacked.view(),
            mayH2,
        )?;
        let place = carried.place;
        var conn = carried.conn;
        match (place) {
            Some(at) => {
                let session = borrow client.sessions[at.session];
                let done = if (options.responseMs == 0) await h2Answer(
                    session,
                    at.slot,
                    body,
                    buffered,
                ) else await Async.timeout(
                    options.responseMs,
                    HttpError.Net(NetError.TimedOut),
                    async () => await h2Answer(session, at.slot, body, buffered),
                );
                var response = Response {
                    client: client,
                    conn: null,
                    origin: origin,
                    permit: permit,
                    viaH2: true,
                    viaH3: false,
                    h3Stream: 0,
                    h3Open: false,
                    session: at.session,
                    slot: at.slot,
                    generation: 0,
                    code: 0,
                    head: Vector<u8>.create(),
                    spans: Vector<HeaderSpan>.create(),
                    data: Vector<u8>.create(),
                    filled: 0,
                    streamed: !buffered,
                    decoded: false,
                    cached: false,
                    trailers: 0,
                };
                let taken = session.takeResponse(at.slot, mut response.head, mut response.spans, mut response.data);
                response.generation = taken.generation;
                response.code = taken.status;
                response.filled = taken.filled;
                response.trailers = taken.trailers;
                match (done) {
                    Ok() => {
                        client.noteAltSvc(origin, response);
                        if (options.cookies) {
                            client.keepCookies(response, url, parts);
                        }
                        if (options.decompress && buffered) {
                            response.decode()?;
                        }
                        return Ok(response);
                    }
                    Err(e) => {
                        let again = options.retryStale && attempts < 3 && session.mayRetry(at.slot, method);
                        // Dropping the response gives the slot back, and resets the stream if it is still open.
                        permit = response.unpermit();
                        if (!again) {
                            return Err(e);
                        }
                    }
                }
            }
            null => {
                var link = conn!;
                link.out.clear();
                match (writeRequestHead(
                    mut link.out,
                    method,
                    url,
                    parts,
                    fields,
                    cookieLine.view(),
                    length,
                    coded,
                    absolute,
                )) {
                    Ok() => {}
                    Err(_) => { return Err(HttpErrors.noMemory()); }
                }
                let done = if (options.responseMs == 0) await answer(
                    mut link,
                    body,
                    head,
                    buffered,
                    options,
                ) else await Async.timeout(
                    options.responseMs,
                    HttpError.Net(NetError.TimedOut),
                    async () => await answer(mut link, body, head, buffered, options),
                );
                match (done) {
                    Ok() => {
                        var response = Response {
                            client: client,
                            conn: Some(link),
                            origin: origin,
                            permit: permit,
                            viaH2: false,
                            viaH3: false,
                            h3Stream: 0,
                            h3Open: false,
                            session: 0,
                            slot: 0,
                            generation: 0,
                            code: 0,
                            head: Vector<u8>.create(),
                            spans: Vector<HeaderSpan>.create(),
                            data: Vector<u8>.create(),
                            filled: 0,
                            streamed: !buffered,
                            decoded: false,
                            cached: false,
                            trailers: 0,
                        };
                        client.noteAltSvc(origin, response);
                        if (options.cookies) {
                            client.keepCookies(response, url, parts);
                        }
                        if (options.decompress && buffered) {
                            response.decode()?;
                        }
                        return Ok(response);
                    }
                    Err(e) => {
                        if (!(options.retryStale && link.stale(method))) {
                            return Err(e);
                        }
                    }
                }
            }
        }
    }
}

/// What carries a request: a stream on an HTTP/2 connection, its HEADERS queued, or an HTTP/1.1 connection.
struct Carrier {
    place: H2Place?;
    conn: Box<Connection>?;
}

/// Finds or makes what carries a request to `origin`: a stream on an HTTP/2 connection that has room, an idle
/// HTTP/1.1 connection, or a new connection of the protocol the server speaks.
async fn connect(
    client: borrow Client,
    origin: usize,
    method: Method,
    url: Slice<u8>,
    parts: UrlParts,
    packed: Slice<u8>,
    length: u64?,
    endStream: bool,
    buffered: bool,
    coded: bool,
    cookiePacked: Slice<u8>,
    mayH2: bool,
) -> Result<Carrier, HttpError> {
    var place: H2Place? = null;
    var conn: Box<Connection>? = null;
    if (mayH2 && client.protocol(origin) != 1) {
        place = client.openStream(
            origin,
            method,
            url,
            parts,
            packed,
            length,
            endStream,
            buffered,
            coded,
            cookiePacked,
        )?;
    }
    if (place == null) {
        conn = client.takeIdle(origin);
    }
    // Whoever dials an origin that may speak HTTP/2 holds its gate: the others wait here, and find the new
    // connection when they get the gate in turn.
    var gate = Permit { slot: null };
    if (place == null && conn == null && mayH2 && client.protocol(origin) != 1) {
        match (client.gate(origin)) {
            Some(token) => {
                match (await token.recvAsync()) {
                    Ok(Some(_)) => {}
                    Ok(null) => { return Err(HttpError.Closed); }
                    Err(e) => { return Err(HttpError.Net(NetErrors.fromAsync(e))); }
                }
                gate.slot = Some(token);
                place = client.openStream(
                    origin,
                    method,
                    url,
                    parts,
                    packed,
                    length,
                    endStream,
                    buffered,
                    coded, cookiePacked,
                )?;
                if (place == null && client.protocol(origin) == 1) {
                    conn = client.takeIdle(origin);
                }
            }
            null => {}
        }
    }
    if (place == null && conn == null) {
        let wire = await dial(client, url, parts, false)?;
        let speaksH2 = mayH2 && (if (parts.secure) wireAlpn(wire) is Alpn.Http2 else true);
        if (speaksH2) {
            let index = match (client.freeSession()) {
                Some(i) => i,
                null => { return Err(HttpError.Net(NetError.LimitExceeded)); },
            };
            match (client.sessions[index].start(Link { wire: wire }, origin)) {
                Ok() => {}
                Err(_) => { return Err(HttpErrors.noMemory()); }
            }
            client.learned(origin, 2);
            place = client.openStream(
                origin,
                method,
                url,
                parts,
                packed,
                length,
                endStream,
                buffered,
                coded, cookiePacked,
            )?;
            if (place == null) {
                return Err(HttpError.Net(NetError.LimitExceeded));
            }
        } else {
            if (parts.secure) {
                client.learned(origin, 1);
            }
            let made = match (Connection.create(wire, client.options.bufferSize)) {
                Ok(c) => c,
                Err(_) => { return Err(HttpErrors.noMemory()); },
            };
            match (Box.create(made)) {
                Ok(b) => { conn = Some(b); }
                Err(_) => { return Err(HttpErrors.noMemory()); }
            }
        }
    }
    gate = Permit { slot: null }; // the connection exists: the next request may look
    return Ok(Carrier { place: place, conn: conn });
}

/// The request written and the response read: its head, and its body too for a buffered response.
async fn answer(
    conn: borrow mut Connection,
    body: Slice<u8>,
    head: bool,
    buffered: bool,
    options: borrow ClientOptions,
) -> Result<void, HttpError> {
    await conn.exchange(body, head, options)?;
    if (buffered) {
        await conn.readBody(options.maxBodyBytes)?;
    }
    return Ok();
}

/// The request's body sent and its response awaited on an HTTP/2 stream: to its end for a buffered response, to
/// its head for a streamed one.
async fn h2Answer(session: borrow H2Session, slot: usize, body: Slice<u8>, buffered: bool) -> Result<void, HttpError> {
    if (body.length > 0) {
        await session.sendBody(slot, body, true)?;
    }
    return await session.progress(slot, if (buffered) WANT_END else WANT_HEAD);
}

/// A new connection to `url`'s origin: each of the host's addresses in turn until one connects, then TLS for https.
/// A connection for requests to the URL's origin: to it, or to the client's proxy and through that. `tunnel`: an
/// HTTP proxy is asked for a tunnel even to an `http` origin (a WebSocket needs the connection to itself).
async fn dial(client: borrow Client, url: Slice<u8>, parts: UrlParts, tunnel: bool) -> Result<Wire, HttpError> {
    let options = borrow client.options;
    let host = match (StringView.fromUtf8(parts.host(url))) {
        Some(h) => h,
        null => { return Err(HttpError.BadUrl); },
    };
    var plain: PlainStream? = null;
    match (client.scriptedDial()) {
        Some(mock) => { plain = Some(PlainStream.mock(mock)); }
        null => {}
    }
    if (plain == null && client.isOffline()) {
        return Err(HttpError.Net(NetError.Closed)); // a test's scripts have run out
    }
    // Where the TCP connection goes: the origin, or the proxy.
    var toHost = host;
    var toPort = parts.port;
    let through = client.proxyCovers(parts.host(url));
    match (borrow client.proxy) {
        Some(p) => {
            if (through) {
                toHost = match (StringView.fromUtf8(p.host.view())) {
                    Some(h) => h,
                    null => { return Err(HttpError.BadUrl); },
                };
                toPort = p.port;
            }
        }
        null => {}
    }
    if (plain == null) {
        var addresses = Vector<SocketAddress>.create();
        match (SocketAddresses.parseIp(toHost, toPort)) {
            Some(a) => {
                match (addresses.push(a)) {
                    Ok() => {}
                    Err(_) => { return Err(HttpErrors.noMemory()); }
                }
            }
            null => {
                match (await AsyncDns.resolve(toHost, toPort)) {
                    Ok(found) => { addresses = found; }
                    Err(e) => { return Err(HttpError.Net(NetErrors.fromAsync(e))); }
                }
            }
        }
        var failure = HttpError.NoAddress;
        if (addresses.length > 0) {
            match (await connectAny(addresses.view(), options.connectMs, options.raceMs)) {
                Ok(tcp) => {
                    match (tcp.setNoDelay(true)) {
                        Ok() => {}
                        Err(_) => {} // the first write says so if the connection is already gone
                    }
                    plain = Some(PlainStream.tcp(tcp));
                }
                Err(e) => { failure = HttpError.Net(e); }
            }
        }
        if (plain == null) {
            return Err(failure);
        }
    }
    var stream = plain!;
    match (borrow client.proxy) {
        Some(p) => {
            let limit = options.connectMs;
            var asked: Result<void, HttpError> = Ok();
            if (!through) {
                // The host is one to reach directly.
            } else if (p.kind is ProxyKind.Socks5) {
                asked = if (limit == 0) await socksConnect(
                    mut stream,
                    p,
                    parts.host(url),
                    parts.port,
                ) else await Async.timeout(
                    limit,
                    HttpError.Net(NetError.TimedOut),
                    async () => await socksConnect(mut stream, p, parts.host(url), parts.port),
                );
            } else if (parts.secure || tunnel) {
                var authority = Vector<u8>.create();
                var built = authority.extend(parts.host(url));
                if (built.isOk()) {
                    built = authority.push(':');
                }
                if (built.isOk()) {
                    var digits = String.create();
                    built = digits.appendNumber(parts.port as u64);
                    if (built.isOk()) {
                        built = authority.extend(digits.view().bytes());
                    }
                }
                match (built) {
                    Ok() => {}
                    Err(_) => { return Err(HttpErrors.noMemory()); }
                }
                asked = if (limit == 0) await httpConnect(mut stream, p, authority.view()) else await Async.timeout(
                    limit,
                    HttpError.Net(NetError.TimedOut),
                    async () => await httpConnect(mut stream, p, authority.view()),
                );
            }
            asked?;
        }
        null => {}
    }
    if (parts.secure) {
        let wire = await secured(client, stream, host)?;
        client.dialed();
        return Ok(wire);
    }
    client.dialed();
    return Ok(Wire.Plain(stream));
}

/// TLS over `stream`, the server's certificate verified for `host`.
async fn secured(client: borrow Client, stream: PlainStream, host: StringView) -> Result<Wire, HttpError> {
    let config = match (borrow client.tls) {
        Some(t) => t,
        null => { return Err(HttpError.NoTls); },
    };
    let ms = client.options.handshakeMs;
    let deadline = if (ms == 0) Deadline.never() else Deadline.after(ms);
    match (await TlsTransport.connect(stream, config, host, deadline)) {
        Ok(t) => { return Ok(Wire.Tls(t)); }
        Err(e) => { return Err(HttpError.Net(e)); }
    }
}

/// A response. Its fields and a buffered body are views of buffers the response holds while it lives: over
/// HTTP/1.1 the connection it came on, over HTTP/2 its stream's. Dropping it gives them back: an HTTP/1.1 connection
/// to the pool if the whole response was read and the server keeps it open (closed otherwise), an HTTP/2 stream's
/// place to its connection (a stream still open is reset).
@noncopy
public struct Response<region c> {
    private client: borrow(c) Client;
    private conn: Box<Connection>?;
    private origin: usize;
    private permit: Permit;
    private viaH2: bool;
    private viaH3: bool;
    /// A streamed response over HTTP/3: its stream with the client's transport, until it is given back.
    private h3Stream: u64;
    private h3Open: bool;
    private session: usize;
    private slot: usize;
    private generation: u64;
    private code: u16;
    /// An HTTP/2 response's fields (`:status` first) and, when buffered, its body: `data[0..filled]`.
    private head: Vector<u8>;
    private spans: Vector<HeaderSpan>;
    private data: Vector<u8>;
    private filled: usize;
    private streamed: bool;
    /// The body was compressed and `data[0..filled]` is its text (`ClientOptions.decompress`).
    private decoded: bool;
    /// It was served from the client's cache: `head`, `spans` and `data` are copies of the stored response.
    private cached: bool;
    /// How many of `spans`, the last ones, are trailers (HTTP/2).
    private trailers: usize;

    /// The status code.
    public fn status(borrow this) -> u16 => match (borrow this.conn) {
        Some(c) => c.parser.status,
        null => this.code,
    };

    /// Whether the response came over HTTP/2.
    public fn isHttp2(borrow this) -> bool => this.viaH2;

    /// Whether the response came over HTTP/3 (`Client.withHttp3`).
    public fn isHttp3(borrow this) -> bool => this.viaH3;

    /// The whole body of a buffered response (`Client.get`, `Client.send`); empty for a streamed one.
    public fn body(borrow this) -> Slice<u8> {
        if (this.decoded) {
            return this.data[0..this.filled];
        }
        return match (borrow this.conn) {
            Some(c) => c.buffer[c.bodyStart..c.bodyEnd],
            null => this.data[0..this.filled],
        };
    }

    /// Whether the response was served from the client's cache (`ClientOptions.cacheBytes`), without the network or
    /// after the server said its copy is still good.
    public fn fromCache(borrow this) -> bool => this.cached;

    /// Whether the body arrived compressed and `body()` is its text. The fields are the server's as they came:
    /// `content-encoding` still names the coding, and `content-length` the compressed size.
    public fn wasDecoded(borrow this) -> bool => this.decoded;

    /// Decompresses a buffered body whose `content-encoding` is `gzip` or `deflate` (one coding; any other, or
    /// several, is left as it is). The text may be as long as a buffered body may be.
    fn decode(borrow mut this) -> Result<void, HttpError> {
        let index = match (this.find("content-encoding")) {
            Some(i) => i,
            null => { return Ok(); },
        };
        let coding = this.value(index).trim();
        let gzip = coding.equalsIgnoreAsciiCase("gzip".bytes()) || coding.equalsIgnoreAsciiCase("x-gzip".bytes());
        if (!gzip && !coding.equalsIgnoreAsciiCase("deflate".bytes())) {
            return Ok();
        }
        if (this.body().length == 0) {
            return Ok(); // a HEAD's answer, a 304: the field describes a body that was not sent
        }
        let limit: usize = checkedTruncate<usize>(this.client.options.maxBodyBytes) ?? 0xFFFFFFFF;
        var text = Vector<u8>.create();
        {
            var inflater = this.client.inflater.write();
            let tables = inflater.data();
            let result = if (gzip) tables.gunzip(
                this.body(),
                mut text,
                limit,
            ) else tables.undeflate(this.body(), mut text, limit);
            match (result) {
                Ok() => {}
                Err(f) => { return Err(HttpError.Response(f)); }
            }
        }
        // Over HTTP/2 `data` held the compressed body: it becomes the stream's spare buffer again on release.
        swap(mut this.data, mut text);
        this.filled = this.data.length;
        this.decoded = true;
        return Ok();
    }

    /// How many fields the head has.
    public fn headerCount(borrow this) -> usize => match (borrow this.conn) {
        Some(c) => c.headers.length,
        null => if (this.spans.length > 0) this.spans.length - 1 - this.trailers else 0,
    };

    /// Field `i`'s name: as the server wrote it over HTTP/1.1, lowercase over HTTP/2.
    public fn name(borrow this, i: usize) -> Slice<u8> => match (borrow this.conn) {
        Some(c) => c.name(i),
        null => this.head[this.spans[i + 1].nameStart..this.spans[i + 1].nameEnd],
    };

    /// Field `i`'s value.
    public fn value(borrow this, i: usize) -> Slice<u8> => match (borrow this.conn) {
        Some(c) => c.value(i),
        null => this.head[this.spans[i + 1].valueStart..this.spans[i + 1].valueEnd],
    };

    /// The index of the first field named `name` (ASCII case ignored), for `value`.
    public fn find(borrow this, name: StringView) -> usize? {
        match (borrow this.conn) {
            Some(c) => { return c.find(name.bytes()); }
            null => {}
        }
        let wanted = name.bytes();
        for (i in 1..this.spans.length - this.trailers) {
            let s = this.spans[i];
            if (s.nameEnd - s.nameStart == wanted.length && this.head[s.nameStart..s.nameEnd].equalsIgnoreAsciiCase(
                wanted,
            )) {
                return Some(i - 1);
            }
        }
        return null;
    }

    /// The value of the first field named `name` (ASCII case ignored).
    public fn header(borrow this, name: StringView) -> Slice<u8>? {
        let i = this.find(name)?;
        return Some(this.value(i));
    }

    /// The body's length when the head gives it (`content-length`); null for a chunked body or one that ends with
    /// the connection, and over HTTP/2 when the server did not say.
    public fn contentLength(borrow this) -> u64? {
        match (borrow this.conn) {
            Some(c) => {
                return match (c.framing) {
                    Framing.Length(n) => Some(n),
                    Framing.None => Some(0u64),
                    _ => null,
                };
            }
            null => {}
        }
        let i = this.find("content-length")?;
        return this.value(i).parseInt<u64>();
    }

    /// The next bytes of a streamed response's body (`Client.open`) into `buffer`: at least one, or 0 at its end.
    public async fn read(borrow mut this, buffer: SliceMut<u8>) -> Result<usize, HttpError> {
        match (borrow mut this.conn) {
            Some(c) => { return await c.readSome(buffer); }
            null => {}
        }
        if (this.h3Open) {
            let n = match (borrow this.client.http3) {
                Some(transport) => await transport.read(this.h3Stream, buffer)?,
                null => 0,
            };
            if (n == 0 && this.trailers == 0) {
                match (borrow this.client.http3) {
                    Some(transport) => {
                        match (transport.trailers(this.h3Stream, mut this.head, mut this.spans)) {
                            Ok(count) => { this.trailers = count; }
                            Err(_) => { return Err(HttpErrors.noMemory()); }
                        }
                    }
                    null => {}
                }
            }
            return Ok(n);
        }
        if (!this.viaH2 || !this.streamed) {
            return Ok(0);
        }
        let session = borrow this.client.sessions[this.session];
        let n = await session.read(this.slot, buffer)?;
        if (n == 0 && this.trailers == 0) {
            // The body has ended: the trailers that came with its end join the response.
            match (session.takeTrailers(this.slot, mut this.head, mut this.spans)) {
                Ok(count) => { this.trailers = count; }
                Err(_) => { return Err(HttpErrors.noMemory()); }
            }
        }
        return Ok(n);
    }

    /// How many trailers the response has: fields sent after the body, over HTTP/2 (over HTTP/1.1 a chunked body's
    /// trailers are skipped). A streamed response has them once `read` has given 0.
    public fn trailerCount(borrow this) -> usize => this.trailers;

    /// Trailer `i`'s name (lowercase) and value.
    public fn trailerName(borrow this, i: usize) -> Slice<u8> {
        let s = this.spans[this.spans.length - this.trailers + i];
        return this.head[s.nameStart..s.nameEnd];
    }

    public fn trailerValue(borrow this, i: usize) -> Slice<u8> {
        let s = this.spans[this.spans.length - this.trailers + i];
        return this.head[s.valueStart..s.valueEnd];
    }

    /// The value of the first trailer named `name` (ASCII case ignored).
    public fn trailer(borrow this, name: StringView) -> Slice<u8>? {
        for (i in 0..this.trailers) {
            if (this.trailerName(i).equalsIgnoreAsciiCase(name.bytes())) {
                return Some(this.trailerValue(i));
            }
        }
        return null;
    }

    /// Whether the whole response has been read.
    public fn isComplete(borrow this) -> bool {
        match (borrow this.conn) {
            Some(c) => { return c.complete; }
            null => {}
        }
        if (this.h3Open) {
            return match (borrow this.client.http3) {
                Some(transport) => transport.isComplete(this.h3Stream),
                null => true,
            };
        }
        if (!this.viaH2 || !this.streamed) {
            return true;
        }
        return this.client.sessions[this.session].isComplete(this.slot);
    }

    /// Ends the response, keeping its place among the origin's requests in flight for the request that is sent
    /// again.
    fn unpermit(this) -> Permit {
        var me = this;
        return replace(mut me.permit, Permit { slot: null });
    }

    drop {
        match (replace(mut this.conn, null)) {
            Some(conn) => {
                if (conn.complete && conn.reusable) {
                    this.client.giveBack(this.origin, conn);
                }
            }
            null => {}
        }
        if (this.h3Open) {
            match (borrow this.client.http3) {
                Some(transport) => { transport.release(this.h3Stream); }
                null => {}
            }
        }
        if (this.viaH2) {
            this.client.sessions[this.session].release(
                this.slot,
                this.generation,
                mut this.head,
                mut this.spans,
                mut this.data,
            );
        }
    }
}

/// A request whose body is being written (`Client.upload`). Dropped before `finish`, the request is abandoned: its
/// HTTP/1.1 connection is closed, its HTTP/2 stream reset.
@noncopy
public struct Upload<region c> {
    /// The response to be, which already holds the connection or the stream.
    private response: Response<c>;
    /// The URL, kept for the cookies the response may set.
    private url: Vector<u8>;
    private parts: UrlParts;
    /// HTTP/1.1 without a length: the body goes as chunks.
    private chunked: bool;
    /// A length was given: `remaining` bytes are still to be written.
    private limited: bool;
    private remaining: u64;
    /// HTTP/1.1: the head is on the wire.
    private started: bool;
    private broken: bool;

    /// Sends the next bytes of the body. Over HTTP/1.1 the first write carries the request's head too; over HTTP/2
    /// it waits for the server's flow-control window when that is full.
    public async fn write(borrow mut this, bytes: Slice<u8>) -> Result<void, HttpError> {
        if (this.broken) {
            return Err(HttpError.Closed);
        }
        if (bytes.length == 0) {
            return Ok();
        }
        if (this.limited) {
            if (bytes.length as u64 > this.remaining) {
                return Err(HttpError.BadRequest);
            }
            this.remaining -= bytes.length as u64;
        }
        if (this.response.viaH2) {
            let client = this.response.client;
            let session = borrow client.sessions[this.response.session];
            let slot = this.response.slot;
            match (await session.sendBody(slot, bytes, false)) {
                Ok() => {}
                Err(e) => {
                    this.broken = true;
                    return Err(e);
                }
            }
            match (await session.progress(slot, WANT_FLUSHED)) {
                Ok() => {}
                Err(e) => {
                    this.broken = true;
                    return Err(e);
                }
            }
            return Ok();
        }
        let chunked = this.chunked;
        let started = this.started;
        var sent: Result<void, NetError> = Ok();
        match (borrow mut this.response.conn) {
            Some(conn) => {
                // What goes before the bytes: the head the first time, and a chunk's size line, after the line end
                // that closes the chunk before.
                var built: Result<void, AllocError> = Ok();
                if (chunked) {
                    if (started) {
                        built = conn.out.extend("\r\n".bytes());
                    }
                    if (built.isOk()) {
                        built = chunkSize(mut conn.out, bytes.length);
                    }
                }
                if (built.isOk() && conn.out.length > 0 && bytes.length <= INLINE_BODY) {
                    built = conn.out.extend(bytes);
                    match (built) {
                        Ok() => { sent = await conn.link.write(conn.out.view()); }
                        Err(_) => {}
                    }
                } else if (built.isOk()) {
                    if (conn.out.length == 0) {
                        sent = await conn.link.write(bytes);
                    } else {
                        sent = await conn.link.writeBoth(conn.out.view(), bytes);
                    }
                }
                conn.out.clear();
                if (built.isErr()) {
                    sent = Err(NetError.Closed);
                }
                if (sent.isErr()) {
                    conn.unsent = true;
                }
            }
            null => { sent = Err(NetError.Closed); }
        }
        this.started = true;
        match (sent) {
            Ok() => { return Ok(); }
            Err(e) => {
                this.broken = true;
                return Err(HttpError.Net(e));
            }
        }
    }

    /// Ends the body and reads the response, within `ClientOptions.responseMs`. `BadRequest` if a length was given
    /// and less was written.
    public async fn finish(this) -> Result<Response<c>, HttpError> {
        var me = this;
        if (me.broken) {
            return Err(HttpError.Closed);
        }
        if (me.limited && me.remaining != 0) {
            return Err(HttpError.BadRequest);
        }
        let client = me.response.client;
        let options = borrow client.options;
        if (me.response.viaH2) {
            let session = borrow client.sessions[me.response.session];
            let slot = me.response.slot;
            session.endBody(slot)?;
            let done = if (options.responseMs == 0) await session.progress(slot, WANT_END) else await Async.timeout(
                options.responseMs,
                HttpError.Net(NetError.TimedOut),
                async () => await session.progress(slot, WANT_END),
            );
            let taken = session.takeResponse(slot, mut me.response.head, mut me.response.spans, mut me.response.data);
            me.response.generation = taken.generation;
            me.response.code = taken.status;
            me.response.filled = taken.filled;
            me.response.trailers = taken.trailers;
            done?;
        } else {
            let chunked = me.chunked;
            let started = me.started;
            match (borrow mut me.response.conn) {
                Some(conn) => {
                    if (chunked) {
                        let closed = if (started) conn.out.extend("\r\n".bytes()) else Ok();
                        let ended = if (closed.isOk()) conn.out.extend("0\r\n\r\n".bytes()) else closed;
                        match (ended) {
                            Ok() => {}
                            Err(_) => { return Err(HttpErrors.noMemory()); }
                        }
                    }
                    let done = if (options.responseMs == 0) await uploadAnswer(
                        mut conn,
                        options,
                    ) else await Async.timeout(
                        options.responseMs,
                        HttpError.Net(NetError.TimedOut),
                        async () => await uploadAnswer(mut conn, options),
                    );
                    done?;
                }
                null => { return Err(HttpError.Closed); }
            }
        }
        if (options.cookies) {
            client.keepCookies(me.response, me.url.view(), me.parts);
        }
        if (options.decompress) {
            me.response.decode()?;
        }
        return Ok(me.response);
    }
}

/// What is left in `out` written (the head of a request without a body, the end of a chunked one), then the
/// response read whole.
async fn uploadAnswer(conn: borrow mut Connection, options: borrow ClientOptions) -> Result<void, HttpError> {
    if (conn.out.length > 0) {
        match (await conn.link.write(conn.out.view())) {
            Ok() => {}
            Err(e) => {
                conn.unsent = true;
                return Err(HttpError.Net(e));
            }
        }
        conn.out.clear();
    }
    await conn.readHead(false, options)?;
    return await conn.readBody(options.maxBodyBytes);
}

/// A chunk's size line: `n` in hex, then the line end.
fn chunkSize(out: borrow mut Vector<u8>, n: usize) -> Result<void, AllocError> {
    var shift: u32 = 60;
    while (shift > 0 && ((n as u64 >> shift) & 15) == 0) {
        shift -= 4;
    }
    loop {
        let digit = truncate<u8>((n as u64 >> shift) & 15);
        out.push(if (digit < 10) '0' + digit else 'a' + (digit - 10))?;
        if (shift == 0) {
            break;
        }
        shift -= 4;
    }
    return out.extend("\r\n".bytes());
}

/// Connects for an upload and prepares its head: queued on the stream over HTTP/2, ready to go with the first
/// bytes of the body over HTTP/1.1.
async fn beginUpload<region c>(
    client: borrow(c) Client,
    method: Method,
    url: Slice<u8>,
    parts: UrlParts,
    fields: Slice<u8>,
    packed: Slice<u8>,
    length: u64?,
) -> Result<Upload<c>, HttpError> {
    if (method is Method.Head) {
        return Err(HttpError.BadRequest);
    }
    if (parts.secure && client.tls == null) {
        return Err(HttpError.NoTls);
    }
    let origin = client.origin(url, parts)?;
    var permit = Permit { slot: null };
    match (client.slots(origin)) {
        Some(slots) => {
            match (await slots.recvAsync()) {
                Ok(Some(_)) => {}
                Ok(null) => { return Err(HttpError.Closed); }
                Err(e) => { return Err(HttpError.Net(NetErrors.fromAsync(e))); }
            }
            permit.slot = Some(slots);
        }
        null => {}
    }
    let options = borrow client.options;
    let mayH2 = client.sessions.length > 0 && (parts.secure || options.http2PriorKnowledge) && !client.viaHttpProxy(
        url,
        parts,
    );
    let coded = options.decompress && !namesField(fields, "accept-encoding".bytes());
    var line = Vector<u8>.create();
    var linePacked = Vector<u8>.create();
    var kept = Vector<u8>.create();
    var ready: Result<void, AllocError> = Ok();
    if (options.cookies) {
        ready = kept.extend(url);
        if (ready.isOk() && !namesField(fields, "cookie".bytes())) {
            ready = client.cookiesFor(url, parts, mut line, mut linePacked);
        }
    }
    if (ready.isOk() && length == null) {
        ready = line.extend("Transfer-Encoding: chunked\r\n".bytes()); // only HTTP/1.1 reads `line`
    }
    let absolute = client.viaHttpProxy(url, parts);
    if (ready.isOk() && absolute) {
        match (borrow client.proxy) {
            Some(p) => { ready = p.authorization(mut line); }
            null => {}
        }
    }
    match (ready) {
        Ok() => {}
        Err(_) => { return Err(HttpErrors.noMemory()); }
    }
    let carried = await connect(
        client,
        origin,
        method,
        url,
        parts,
        packed,
        length,
        false,
        true,
        coded,
        linePacked.view(),
        mayH2,
    )?;
    var conn = carried.conn;
    var viaH2 = false;
    var session: usize = 0;
    var slot: usize = 0;
    var generation: u64 = 0;
    match (carried.place) {
        Some(at) => {
            viaH2 = true;
            session = at.session;
            slot = at.slot;
            generation = client.sessions[at.session].currentGeneration();
        }
        null => {
            match (borrow mut conn) {
                Some(link) => {
                    link.out.clear();
                    match (writeRequestHead(
                        mut link.out,
                        method,
                        url,
                        parts,
                        fields,
                        line.view(),
                        length,
                        coded,
                        absolute,
                    )) {
                        Ok() => {}
                        Err(_) => { return Err(HttpErrors.noMemory()); }
                    }
                    link.filled = 0;
                    link.received = false;
                    link.unsent = false;
                    link.complete = false;
                    link.reusable = false;
                }
                null => {}
            }
        }
    }
    let limited = length != null;
    return Ok(Upload {
        response: Response {
            client: client,
            conn: conn,
            origin: origin,
            permit: permit,
            viaH2: viaH2,
            viaH3: false,
            h3Stream: 0,
            h3Open: false,
            session: session,
            slot: slot,
            generation: generation,
            code: 0,
            head: Vector<u8>.create(),
            spans: Vector<HeaderSpan>.create(),
            data: Vector<u8>.create(),
            filled: 0,
            streamed: false,
            decoded: false,
            cached: false,
            trailers: 0,
        },
        url: kept,
        parts: parts,
        chunked: !limited,
        limited: limited,
        remaining: length ?? 0,
        started: false,
        broken: false,
    });
}
