// The JSON calls against scripted connections: what goes on the wire, and what comes back as a value.
import web_transport;
import httpclient;
import json;

struct Server {
    host: String;
    port: u16;
}

impl ToJson for Server {
    fn toJson(borrow this, w: borrow mut JsonWriter) -> Result<void, JsonWriteError> {
        w.beginObject()?;
        w.field("host", this.host)?;
        w.field("port", this.port)?;
        return w.endObject();
    }
}

impl FromJson for Server {
    public fn fromJson(value: borrow JsonValue) -> Result<Server, DecodeError> {
        Decode.expectObject(value, "a server")?;
        return Ok(Server { host: Decode.field<String>(value, "host")?, port: Decode.field<u16>(value, "port")? });
    }
}

fn made<T>(r: Result<T, AllocError>) -> Result<T, TestFailure> {
    match (r) {
        Ok(v) => { return Ok(v); }
        Err(_) => { return Err(TestFailure.create("out of memory")); }
    }
}

/// The next dial of `client` gets a connection whose server sends `text`; what the client writes goes to `copies`.
fn script(client: borrow Client, text: StringView, copies: borrow Channel<u8>) -> Result<void, TestFailure> {
    let mock = made(MockTransport.create(text.bytes()))?.withCopiesTo(copies);
    return made(client.script(mock));
}

fn written(copies: borrow Channel<u8>) -> Result<Vector<u8>, TestFailure> {
    var out = Vector<u8>.create();
    loop {
        match (copies.tryRecv()) {
            Some(b) => { made(out.push(b))?; }
            null => { return Ok(out); }
        }
    }
}

fn why(e: borrow JsonFailure) -> TestFailure => match (e) {
    JsonFailure.Http(h) => TestFailure.create(HttpErrors.describe(h)),
    JsonFailure.Status(_) => TestFailure.create("a status that is not 2xx"),
    JsonFailure.Encode(_) => TestFailure.create("the value could not be written"),
    JsonFailure.Decode(_) => TestFailure.create("the body could not be decoded"),
};

@test
async fn valuesThereAndBack() -> Result<void, TestFailure> {
    let copies = made(Channel<u8>.create(4096))?;
    let client = Client.create(ClientOptions.defaults());
    script(
        client,
        "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 30\r\nConnection: close\r\n\r\n{\"host\": \"edge\", \"port\": 8080}",
        copies,
    )?;
    {
        let got = match (await getJson<Server>(client, "http://example.com/server")) {
            Ok(s) => s,
            Err(e) => { return Err(why(e)); },
        };
        Check.equalBytes("edge".bytes(), got.host.view().bytes())?;
        Check.equalU64(8080, got.port as u64)?;
    }
    let asked = written(copies)?;
    let get = "GET /server HTTP/1.1\r\nHost: example.com\r\nAccept: application/json\r\n\r\n";
    Check.equalBytes(get.bytes(), asked.view())?;

    // A value sent, and the answer read into another.
    script(
        client,
        "HTTP/1.1 201 Created\r\nContent-Length: 24\r\nConnection: close\r\n\r\n{\"host\":\"made\",\"port\":9}",
        copies,
    )?;
    var host = String.create();
    made(host.append("a \"new\" one"))?;
    let mine = Server { host: host, port: 443 };
    {
        let got = match (await postJson<Server, Server>(client, "http://example.com/servers", mine)) {
            Ok(s) => s,
            Err(e) => { return Err(why(e)); },
        };
        Check.equalBytes("made".bytes(), got.host.view().bytes())?;
        Check.equalU64(9, got.port as u64)?;
    }
    let posted = written(copies)?;
    let post = "POST /servers HTTP/1.1\r\nHost: example.com\r\nAccept: application/json\r\nContent-Type: application/json\r\nContent-Length: 35\r\n\r\n{\"host\":\"a \\\"new\\\" one\",\"port\":443}";
    Check.equalBytes(post.bytes(), posted.view())?;

    // Any JSON at all, as a tree.
    script(client, "HTTP/1.1 200 OK\r\nContent-Length: 13\r\nConnection: close\r\n\r\n[1, {\"a\": 2}]", copies)?;
    {
        let tree = match (await getJson<JsonValue>(client, "http://example.com/any")) {
            Ok(t) => t,
            Err(e) => { return Err(why(e)); },
        };
        match (tree.pointer("/1/a")) {
            Some(v) => { Check.equalU64(2, v.asU64() ?? 0)?; }
            null => { return Check.fail("the tree's second element"); }
        }
    }
    return Ok();
}

@test
async fn answersThatAreNoValue() -> Result<void, TestFailure> {
    let copies = made(Channel<u8>.create(4096))?;
    let client = Client.create(ClientOptions.defaults());
    script(client, "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nnot found", copies)?;
    match (await getJson<Server>(client, "http://example.com/missing")) {
        Err(JsonFailure.Status(code)) => { Check.equalU64(404, code as u64)?; }
        _ => { return Check.fail("a 404 is a status, not a value"); }
    }
    script(client, "HTTP/1.1 200 OK\r\nContent-Length: 9\r\nConnection: close\r\n\r\n<html/>  ", copies)?;
    match (await getJson<Server>(client, "http://example.com/page")) {
        Err(JsonFailure.Decode(_)) => {}
        _ => { return Check.fail("a page is not JSON"); }
    }
    script(client, "HTTP/1.1 200 OK\r\nContent-Length: 30\r\nConnection: close\r\n\r\n{\"host\":\"edge\",\"port\":70000}  ", copies)?;
    match (await getJson<Server>(client, "http://example.com/far")) {
        Err(JsonFailure.Decode(e)) => {
            var text = String.create();
            made(e.describe(mut text))?;
            Check.isTrue(text.view().bytes().indexOf("port".bytes()) != null, "the error names the member")?;
        }
        _ => { return Check.fail("a port that is no u16"); }
    }
    // Nothing is scripted: the request gets no response.
    match (await getJson<Server>(client, "http://example.com/gone")) {
        Err(JsonFailure.Http(_)) => {}
        _ => { return Check.fail("no connection, no value"); }
    }
    return Ok();
}
