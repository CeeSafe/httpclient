// WebSockets: the handshake's hash, then conversations with a scripted server.
import web_core;
import web_transport;
import encoding;

fn digestHex(text: StringView) -> Result<Vector<u8>, TestFailure> {
    let digest = sha1(text.bytes());
    var out = Vector<u8>.create();
    made(Hex.encode(digest[..], mut out))?;
    return Ok(out);
}

/// The bytes written as hex.
fn raw(hex: StringView) -> Result<Vector<u8>, TestFailure> {
    var out = Vector<u8>.create();
    match (Hex.decode(hex.bytes(), mut out)) {
        Ok() => {}
        Err(_) => { return Err(TestFailure.create("bad hex in a test")); }
    }
    return Ok(out);
}

@test
fn sha1Vectors() -> Result<void, TestFailure> {
    Check.equalBytes("da39a3ee5e6b4b0d3255bfef95601890afd80709".bytes(), digestHex("")?.view())?;
    Check.equalBytes("a9993e364706816aba3e25717850c26c9cd0d89d".bytes(), digestHex("abc")?.view())?;
    // 56 bytes: the length no longer fits the block the message ends in.
    Check.equalBytes(
        "84983e441c3bd26ebaae4aa1f95129e5e54670f1".bytes(),
        digestHex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")?.view(),
    )?;
    Check.equalBytes(
        "ce4303f6b22257d9c9cf314ef1dee4707c6e1c13".bytes(),
        digestHex("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")?.view(),
    )?;
    // RFC 6455 §1.3's example.
    var accept = Vector<u8>.create();
    made(acceptFor("dGhlIHNhbXBsZSBub25jZQ==".bytes(), mut accept))?;
    Check.equalBytes("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=".bytes(), accept.view())?;
    return Ok();
}

/// The server's answer to a handshake with the key of 16 zero bytes, with `more` fields.
fn switching(out: borrow mut Vector<u8>, more: StringView) -> Result<void, TestFailure> {
    made(out.extend("HTTP/1.1 101 Switching Protocols\r\nUpgrade: WebSocket\r\nConnection: keep-alive, Upgrade\r\nSec-WebSocket-Accept: ".bytes()))?;
    made(acceptFor("AAAAAAAAAAAAAAAAAAAAAA==".bytes(), mut out))?;
    made(out.extend("\r\n".bytes()))?;
    made(out.extend(more.bytes()))?;
    return made(out.extend("\r\n".bytes()));
}

/// A server's frame: `first` is its first byte (FIN and the opcode).
fn serverFrame(out: borrow mut Vector<u8>, first: u8, payload: Slice<u8>) -> Result<void, TestFailure> {
    made(out.push(first))?;
    if (payload.length < 126) {
        made(out.push(truncate<u8>(payload.length)))?;
    } else if (payload.length < 65536) {
        made(out.push(126))?;
        made(out.push(truncate<u8>(payload.length >> 8)))?;
        made(out.push(truncate<u8>(payload.length)))?;
    } else {
        made(out.push(127))?;
        for (i in 0..8) {
            made(out.push(truncate<u8>(payload.length as u64 >> ((7 - truncate<u64>(i)) * 8))))?;
        }
    }
    return made(out.extend(payload));
}

/// The client's frame at `wire[at]`: its first byte, its payload unmasked into `payload`, `at` moved past it.
fn clientFrame(wire: Slice<u8>, at: borrow mut usize, payload: borrow mut Vector<u8>) -> Result<u8, TestFailure> {
    payload.clear();
    var p = *at;
    Check.isTrue(wire.length >= p + 6, "a whole frame header")?;
    let first = wire[p];
    Check.isTrue((wire[p + 1] & 0x80) != 0, "a client masks")?;
    var length = (wire[p + 1] & 127) as usize;
    p += 2;
    if (length == 126) {
        length = wire.readBE<u16>(p) as usize;
        p += 2;
    } else if (length == 127) {
        length = truncate<usize>(wire.readBE<u64>(p));
        p += 8;
    }
    Check.isTrue(wire.length >= p + 4 + length, "a whole frame")?;
    for (i in 0..length) {
        made(payload.push(wire[p + 4 + i] ^ wire[p + i % 4]))?;
    }
    *at = p + 4 + length;
    return Ok(first);
}

async fn opened<region c>(client: borrow(c) Client, request: borrow Request) -> Result<WebSocket<c>, TestFailure> {
    let key = [0u8; 16];
    return match (await client.webSocketWithKey(request, WebSocketOptions.defaults(), key[..])) {
        Ok(ws) => Ok(ws),
        Err(e) => Err(failed(e)),
    };
}

/// What `receive` gave: 1 text, 2 binary, 100000 + the code for a close.
async fn received(ws: borrow mut WebSocket, into: borrow mut Vector<u8>) -> Result<u32, TestFailure> {
    return match (await ws.receive(mut into)) {
        Ok(m) => match (m) {
            Message.Text => Ok(1),
            Message.Binary => Ok(2),
            Message.Close(code) => Ok(100000 + code as u32),
        },
        Err(e) => Err(failed(e)),
    };
}

fn wsRequest(url: StringView) -> Result<Request, TestFailure> {
    return match (Request.create(Method.Get, url)) {
        Ok(r) => Ok(r),
        Err(e) => Err(failed(e)),
    };
}

async fn conversation(chunk: usize) -> Result<void, TestFailure> {
    let copies = made(Channel<u8>.create(200000))?;
    let client = Client.create(ClientOptions.defaults());
    var server = Vector<u8>.create();
    switching(mut server, "Sec-WebSocket-Protocol: superchat\r\n")?;
    serverFrame(mut server, 0x81, "hello".bytes())?;
    serverFrame(mut server, 0x89, "p".bytes())?; // a ping
    serverFrame(mut server, 0x02, "ab".bytes())?; // a binary message in two frames, a ping between them
    serverFrame(mut server, 0x89, "mid".bytes())?;
    serverFrame(mut server, 0x8A, "".bytes())?; // a pong nobody asked for
    serverFrame(mut server, 0x80, "cd".bytes())?;
    var large = Vector<u8>.create();
    for (i in 0..70000) {
        made(large.push(truncate<u8>(i * 7)))?;
    }
    serverFrame(mut server, 0x82, large[0..300])?;
    serverFrame(mut server, 0x82, large.view())?;
    serverFrame(mut server, 0x81, "".bytes())?;
    serverFrame(mut server, 0x88, raw("03e8627965")?.view())?;
    scriptBytes(client, server.view(), chunk, 0, copies)?;
    var request = wsRequest("ws://example.com/chat?room=1")?;
    match (request.header("Sec-WebSocket-Protocol", "chat, superchat")) {
        Ok() => {}
        Err(e) => { return Err(failed(e)); }
    }
    var ws = await opened(client, request)?;
    Check.equalBytes("superchat".bytes(), ws.protocol())?;
    var into = Vector<u8>.create();
    match (await ws.sendText("hi")) {
        Ok() => {}
        Err(e) => { return Err(failed(e)); }
    }
    Check.equalU64(1, await received(mut ws, mut into)? as u64)?;
    Check.equalBytes("hello".bytes(), into.view())?;
    Check.equalU64(2, await received(mut ws, mut into)? as u64)?;
    Check.equalBytes("abcd".bytes(), into.view())?;
    Check.equalU64(2, await received(mut ws, mut into)? as u64)?;
    Check.equalBytes(large[0..300], into.view())?;
    Check.equalU64(2, await received(mut ws, mut into)? as u64)?;
    Check.equalBytes(large.view(), into.view())?;
    match (await ws.sendBinary(large.view())) {
        Ok() => {}
        Err(e) => { return Err(failed(e)); }
    }
    match (await ws.sendBinary(large[0..1000])) {
        Ok() => {}
        Err(e) => { return Err(failed(e)); }
    }
    Check.equalU64(1, await received(mut ws, mut into)? as u64)?;
    Check.equalU64(0, into.length as u64)?;
    Check.equalU64(101000, await received(mut ws, mut into)? as u64)?;
    Check.equalBytes("bye".bytes(), into.view())?;
    Check.isTrue((await ws.receive(mut into)).isErr(), "nothing after the close")?;
    Check.isTrue((await ws.sendText("late")).isErr(), "nothing sent after the close")?;
    // What the client wrote: the upgrade, then its frames, every one masked.
    let wire = written(copies)?;
    let head = "GET /chat?room=1 HTTP/1.1\r\nHost: example.com\r\nSec-WebSocket-Protocol: chat, superchat\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: AAAAAAAAAAAAAAAAAAAAAA==\r\n\r\n";
    Check.isTrue(wire.length > head.length, "the upgrade and frames")?;
    Check.equalBytes(head.bytes(), wire[0..head.length])?;
    var at = head.length;
    var payload = Vector<u8>.create();
    Check.equalU64(0x81, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes("hi".bytes(), payload.view())?;
    Check.equalU64(0x8A, clientFrame(wire.view(), mut at, mut payload)? as u64)?; // the pongs
    Check.equalBytes("p".bytes(), payload.view())?;
    Check.equalU64(0x8A, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes("mid".bytes(), payload.view())?;
    Check.equalU64(0x82, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes(large.view(), payload.view())?;
    Check.equalU64(0x82, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes(large[0..1000], payload.view())?;
    Check.equalU64(0x88, clientFrame(wire.view(), mut at, mut payload)? as u64)?; // the close, echoed
    Check.equalBytes(raw("03e8")?.view(), payload.view())?;
    Check.equalU64(wire.length as u64, at as u64)?;
    return Ok();
}

@test
async fn aConversation() -> Result<void, TestFailure> {
    await conversation(0)?;
    await conversation(1)?;
    return await conversation(977);
}

@test
async fn theClientClosesFirst() -> Result<void, TestFailure> {
    let copies = made(Channel<u8>.create(8192))?;
    let client = Client.create(ClientOptions.defaults());
    var server = Vector<u8>.create();
    switching(mut server, "")?;
    serverFrame(mut server, 0x81, "last".bytes())?;
    serverFrame(mut server, 0x88, raw("03e9")?.view())?;
    scriptBytes(client, server.view(), 0, 0, copies)?;
    let request = wsRequest("ws://example.com:8080/")?;
    var ws = await opened(client, request)?;
    Check.equalU64(0, ws.protocol().length as u64)?;
    match (await ws.close(1000, "done")) {
        Ok() => {}
        Err(e) => { return Err(failed(e)); }
    }
    Check.isTrue((await ws.ping("x".bytes())).isErr(), "nothing after our close")?;
    var into = Vector<u8>.create();
    Check.equalU64(1, await received(mut ws, mut into)? as u64)?; // what was on its way still arrives
    Check.equalBytes("last".bytes(), into.view())?;
    Check.equalU64(101001, await received(mut ws, mut into)? as u64)?;
    let wire = written(copies)?;
    let head = "GET / HTTP/1.1\r\nHost: example.com:8080\r\n";
    Check.equalBytes(head.bytes(), wire[0..head.length])?;
    var at = (wire.view().indexOf("\r\n\r\n".bytes()) ?? 0) + 4;
    var payload = Vector<u8>.create();
    Check.equalU64(0x88, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes(raw("03e8646f6e65")?.view(), payload.view())?;
    Check.equalU64(wire.length as u64, at as u64)?; // the server's close is not answered twice
    return Ok();
}

/// A handshake answered with `answer`: the status if the server did not switch, 1 for an answer that breaks the
/// protocol, 2 for another error.
async fn refused(answer: Slice<u8>, offer: StringView) -> Result<u64, TestFailure> {
    let copies = made(Channel<u8>.create(8192))?;
    let client = Client.create(ClientOptions.defaults());
    scriptBytes(client, answer, 0, 0, copies)?;
    var request = wsRequest("ws://example.com/")?;
    if (offer.length > 0) {
        match (request.header("Sec-WebSocket-Protocol", offer)) {
            Ok() => {}
            Err(e) => { return Err(failed(e)); }
        }
    }
    let key = [0u8; 16];
    return match (await client.webSocketWithKey(request, WebSocketOptions.defaults(), key[..])) {
        Ok(_) => Err(TestFailure.create("the handshake was accepted")),
        Err(e) => match (e) {
            HttpError.NotSwitched(status) => Ok(status as u64),
            _ => if (HttpErrors.describe(e).bytes() == "bad WebSocket handshake or frame".bytes()) Ok(1) else Ok(2),
        },
    };
}

@test
async fn handshakesThatAreRefused() -> Result<void, TestFailure> {
    Check.equalU64(404, await refused("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n".bytes(), "")?)?;
    // An accept for another key.
    let wrong = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n";
    Check.equalU64(1, await refused(wrong.bytes(), "")?)?;
    var none = Vector<u8>.create();
    switching(mut none, "Sec-WebSocket-Protocol: chat\r\n")?;
    Check.equalU64(1, await refused(none.view(), "")?)?; // a subprotocol nobody offered
    Check.equalU64(1, await refused(none.view(), "superchat, chatty")?)?;
    var extension = Vector<u8>.create();
    switching(mut extension, "Sec-WebSocket-Extensions: permessage-deflate\r\n")?;
    Check.equalU64(1, await refused(extension.view(), "")?)?;
    let client = Client.create(ClientOptions.defaults());
    let post = match (Request.create(Method.Post, "ws://example.com/")) {
        Ok(r) => r,
        Err(e) => { return Err(failed(e)); },
    };
    Check.isTrue((await client.webSocket(post, WebSocketOptions.defaults())).isErr(), "only a GET upgrades")?;
    let secure = wsRequest("wss://example.com/")?;
    Check.isTrue((await client.webSocket(secure, WebSocketOptions.defaults())).isErr(), "wss needs TLS")?;
    return Ok();
}

/// A server that sends `frames` after the handshake: the code of the close the client answers its fault with.
async fn faultCode(frames: Slice<u8>, limit: usize) -> Result<u64, TestFailure> {
    let copies = made(Channel<u8>.create(8192))?;
    let client = Client.create(ClientOptions.defaults());
    var server = Vector<u8>.create();
    switching(mut server, "")?;
    made(server.extend(frames))?;
    scriptBytes(client, server.view(), 0, 0, copies)?;
    let request = wsRequest("ws://example.com/")?;
    var options = WebSocketOptions.defaults();
    options.maxMessageBytes = limit;
    let key = [0u8; 16];
    var ws = match (await client.webSocketWithKey(request, options, key[..])) {
        Ok(w) => w,
        Err(e) => { return Err(failed(e)); },
    };
    var into = Vector<u8>.create();
    loop {
        match (await ws.receive(mut into)) {
            Ok(_) => {}
            Err(_) => { break; }
        }
    }
    Check.isTrue((await ws.receive(mut into)).isErr(), "done after a fault")?;
    let wire = written(copies)?;
    var at = (wire.view().indexOf("\r\n\r\n".bytes()) ?? 0) + 4;
    if (at == wire.length) {
        return Ok(0); // nothing was sent: the connection just ended
    }
    var payload = Vector<u8>.create();
    Check.equalU64(0x88, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalU64(2, payload.length as u64)?;
    Check.equalU64(wire.length as u64, at as u64)?;
    return Ok(payload.readBE<u16>(0) as u64);
}

@test
async fn framesThatBreakTheProtocol() -> Result<void, TestFailure> {
    Check.equalU64(1002, await faultCode(raw("8182000000006869")?.view(), 1000)?)?; // a server that masks
    Check.equalU64(1002, await faultCode(raw("c1026869")?.view(), 1000)?)?; // a reserved bit
    Check.equalU64(1002, await faultCode(raw("83026869")?.view(), 1000)?)?; // an opcode that does not exist
    Check.equalU64(1002, await faultCode(raw("80026869")?.view(), 1000)?)?; // a continuation of nothing
    Check.equalU64(1002, await faultCode(raw("010268698102686f")?.view(), 1000)?)?; // a message inside a message
    Check.equalU64(1002, await faultCode(raw("090170")?.view(), 1000)?)?; // a ping in pieces
    Check.equalU64(1002, await faultCode(raw("880178")?.view(), 1000)?)?; // a close with half a code
    Check.equalU64(1007, await faultCode(raw("8102c328")?.view(), 1000)?)?; // text that is not UTF-8
    Check.equalU64(1009, await faultCode(raw("827e03e9")?.view(), 1000)?)?; // 1001 bytes announced
    Check.equalU64(1009, await faultCode(raw("0203616263807e03e6")?.view(), 1000)?)?; // 3 + 998
    Check.equalU64(0, await faultCode(raw("810568656c")?.view(), 1000)?)?; // cut short: an error, nothing to say
    return Ok();
}

/// A socket opened with compression offered, to a server that sends `frames` after agreeing to it.
async fn compressing<region c>(client: borrow(c) Client, frames: Slice<u8>, limit: usize, from: usize, copies: borrow Channel<u8>) -> Result<WebSocket<c>, TestFailure> {
    var server = Vector<u8>.create();
    switching(mut server, "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover\r\n")?;
    made(server.extend(frames))?;
    scriptBytes(client, server.view(), 0, 0, copies)?;
    let request = wsRequest("ws://example.com/")?;
    var options = WebSocketOptions.defaults();
    options.compress = true;
    options.compressMinBytes = from;
    options.maxMessageBytes = limit;
    let key = [0u8; 16];
    return match (await client.webSocketWithKey(request, options, key[..])) {
        Ok(w) => Ok(w),
        Err(e) => Err(failed(e)),
    };
}

@test
async fn compressedMessages() -> Result<void, TestFailure> {
    Check.isTrue(agreesDeflate("permessage-deflate; server_no_context_takeover".bytes()), "as offered")?;
    Check.isTrue(
        agreesDeflate("Permessage-Deflate;client_no_context_takeover; SERVER_NO_CONTEXT_TAKEOVER ;server_max_window_bits=12".bytes()),
        "with what it may add",
    )?;
    Check.isTrue(!agreesDeflate("permessage-deflate".bytes()), "a server that keeps its context")?;
    Check.isTrue(!agreesDeflate("permessage-deflate; server_no_context_takeover; other=1".bytes()), "a parameter nobody knows")?;
    Check.isTrue(!agreesDeflate("x-webkit-deflate-frame".bytes()), "another extension")?;
    Check.isTrue(!agreesDeflate("permessage-deflate; server_no_context_takeover, permessage-deflate".bytes()), "two")?;
    // What `zlib` makes of the messages with a sync flush, the last four bytes taken off (RFC 7692 §7.2.1).
    let hello = raw("f248cdc9c9d751c840a192f3730b8a528b8b535314caf38b725214153ca8aa0c00")?;
    let many = raw("ecc13101000000c2a0da8b6f0d0fa00000807703")?;
    var frames = Vector<u8>.create();
    serverFrame(mut frames, 0xC1, hello.view())?; // text, compressed
    serverFrame(mut frames, 0x81, "plain".bytes())?; // not every message has to be
    serverFrame(mut frames, 0x42, many[0..7])?; // binary, compressed, in two frames with a ping between
    serverFrame(mut frames, 0x89, "".bytes())?;
    serverFrame(mut frames, 0x80, many[7..])?;
    serverFrame(mut frames, 0x88, raw("03e8")?.view())?;
    let copies = made(Channel<u8>.create(8192))?;
    let client = Client.create(ClientOptions.defaults());
    var ws = await compressing(client, frames.view(), 65536, 128, copies)?;
    var into = Vector<u8>.create();
    Check.equalU64(1, await received(mut ws, mut into)? as u64)?;
    var expected = Vector<u8>.create();
    for (k in 0..3) {
        made(expected.extend("Hello, hello, hello, compressed world! ".bytes()))?;
    }
    Check.equalBytes(expected.view(), into.view())?;
    Check.equalU64(1, await received(mut ws, mut into)? as u64)?;
    Check.equalBytes("plain".bytes(), into.view())?;
    Check.equalU64(2, await received(mut ws, mut into)? as u64)?;
    Check.equalU64(3000, into.length as u64)?;
    var same = true;
    for (b in into.view()) {
        if (b != 'x') {
            same = false;
        }
    }
    Check.isTrue(same, "three thousand x")?;
    Check.equalU64(101000, await received(mut ws, mut into)? as u64)?;
    // The offer is in the upgrade.
    let wire = written(copies)?;
    let offer = "Sec-WebSocket-Extensions: permessage-deflate; server_no_context_takeover; client_no_context_takeover\r\n\r\n";
    Check.isTrue(wire.view().indexOf(offer.bytes()) != null, "the offer")?;
    return Ok();
}

/// As `faultCode`, on a socket where compression was agreed.
async fn deflateFault(frames: Slice<u8>, limit: usize) -> Result<u64, TestFailure> {
    let copies = made(Channel<u8>.create(8192))?;
    let client = Client.create(ClientOptions.defaults());
    var ws = await compressing(client, frames, limit, 128, copies)?;
    var into = Vector<u8>.create();
    loop {
        match (await ws.receive(mut into)) {
            Ok(_) => {}
            Err(_) => { break; }
        }
    }
    let wire = written(copies)?;
    var at = (wire.view().indexOf("\r\n\r\n".bytes()) ?? 0) + 4;
    var payload = Vector<u8>.create();
    Check.equalU64(0x88, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    return Ok(payload.readBE<u16>(0) as u64);
}

@test
async fn compressedMessagesThatAreWrong() -> Result<void, TestFailure> {
    Check.equalU64(1007, await deflateFault(raw("c20107")?.view(), 1000)?)?; // a block type that does not exist
    Check.equalU64(1007, await deflateFault(raw("c207ecc13101000000")?.view(), 1000)?)?; // cut off inside a block's code lengths
    // Twenty bytes that become three thousand: more than the socket takes.
    Check.equalU64(1009, await deflateFault(raw("c214ecc13101000000c2a0da8b6f0d0fa00000807703")?.view(), 1000)?)?;
    Check.equalU64(1002, await deflateFault(raw("020161c00161")?.view(), 1000)?)?; // marked on a continuation
    Check.equalU64(1002, await deflateFault(raw("c900")?.view(), 1000)?)?; // marked on a ping
    Check.equalU64(1002, await deflateFault(raw("a10161")?.view(), 1000)?)?; // the second reserved bit
    return Ok();
}

@test
async fn messagesSentCompressed() -> Result<void, TestFailure> {
    var frames = Vector<u8>.create();
    serverFrame(mut frames, 0x88, raw("03e8")?.view())?;
    let copies = made(Channel<u8>.create(8192))?;
    let client = Client.create(ClientOptions.defaults());
    var ws = await compressing(client, frames.view(), 65536, 8, copies)?;
    // Noise that no compressor shortens, for a message that goes as it is.
    var noise = Vector<u8>.create();
    var seed: u32 = 7;
    for (i in 0..200) {
        seed = truncate<u32>((seed as u64 * 1103515245 + 12345) & 0x7FFFFFFF);
        made(noise.push(truncate<u8>(seed >> 16)))?;
    }
    var many = Vector<u8>.create();
    made(many.resize(3000, 'x'))?;
    let sent = (await ws.sendText("Hello")).isOk() && (await ws.sendText("HelloHelloHelloHello")).isOk() &&
        (await ws.sendBinary(many.view())).isOk() && (await ws.sendBinary(noise.view())).isOk() &&
        (await ws.ping("HelloHelloHelloHello".bytes())).isOk();
    Check.isTrue(sent, "five frames")?;
    var into = Vector<u8>.create();
    Check.equalU64(101000, await received(mut ws, mut into)? as u64)?;
    let wire = written(copies)?;
    var at = (wire.view().indexOf("\r\n\r\n".bytes()) ?? 0) + 4;
    var payload = Vector<u8>.create();
    // Below `compressMinBytes`: as it is.
    Check.equalU64(0x81, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes("Hello".bytes(), payload.view())?;
    // Five literals and a match of 15 at distance 5, by RFC 1951's fixed codes (the bytes are worked out in
    // tests/deflate.cee).
    Check.equalU64(0xC1, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes(raw("f248cdc9c947230000")?.view(), payload.view())?;
    // A run compresses to a few bytes, which the inflater turns back into it.
    Check.equalU64(0xC2, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.isTrue(payload.length < 40, "three thousand x in a few bytes")?;
    let tail = [0u8, 0, 0xFF, 0xFF, 1, 0, 0, 0xFF, 0xFF];
    made(payload.extend(tail[..]))?;
    var inflater = Inflater.create();
    var back = Vector<u8>.create();
    Check.isTrue(inflater.inflateRaw(payload.view(), mut back, 65536).isOk(), "it decodes")?;
    Check.equalBytes(many.view(), back.view())?;
    // What would not get shorter goes as it is, and a ping is never compressed.
    Check.equalU64(0x82, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes(noise.view(), payload.view())?;
    Check.equalU64(0x89, clientFrame(wire.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes("HelloHelloHelloHello".bytes(), payload.view())?;
    return Ok();
}

/// An HTTP/2 server's first bytes: its SETTINGS, which allow extended CONNECT if `connect`, and the answer to a GET
/// on stream 1.
fn h2Greeting(server: borrow mut Vector<u8>, connect: bool) -> Result<void, TestFailure> {
    if (connect) {
        frame(mut server, 4, 0, 0, raw("000800000001")?.view())?;
    } else {
        settings(mut server)?;
    }
    headers(mut server, 1, "200", [], 4)?;
    return data(mut server, 1, "ok", true);
}

async fn gotOk(client: borrow Client, url: StringView) -> Result<void, TestFailure> {
    let response = match (await client.get(url)) {
        Ok(r) => r,
        Err(e) => { return Err(failed(e)); },
    };
    return Check.equalU64(200, response.status() as u64);
}

@test
async fn overAnHttp2Connection() -> Result<void, TestFailure> {
    let copies = made(Channel<u8>.create(8192))?;
    let client = h2Client();
    // One connection: a GET on stream 1, then the WebSocket on stream 3, whose server sends a message, a ping
    // and its close. The first read gives the first part alone.
    var server = Vector<u8>.create();
    h2Greeting(mut server, true)?;
    let first = server.length;
    let chosen = ["sec-websocket-protocol", "chat"];
    headers(mut server, 3, "200", chosen[..], 4)?;
    var frames = Vector<u8>.create();
    serverFrame(mut frames, 0x81, "hi".bytes())?;
    serverFrame(mut frames, 0x89, "p".bytes())?;
    serverFrame(mut frames, 0x88, raw("03e8")?.view())?;
    frame(mut server, 0, 0, 3, frames.view())?;
    scriptBytes(client, server.view(), first, 0, copies)?;
    await gotOk(client, "http://example.com/")?;
    var request = wsRequest("ws://example.com/chat")?;
    match (request.header("Sec-WebSocket-Protocol", "chat")) {
        Ok() => {}
        Err(e) => { return Err(failed(e)); }
    }
    {
        var ws = match (await client.webSocket(request, WebSocketOptions.defaults())) {
            Ok(w) => w,
            Err(e) => { return Err(failed(e)); },
        };
        Check.equalBytes("chat".bytes(), ws.protocol())?;
        Check.isTrue((await ws.sendText("yo")).isOk(), "a message")?;
        var into = Vector<u8>.create();
        Check.equalU64(1, await received(mut ws, mut into)? as u64)?;
        Check.equalBytes("hi".bytes(), into.view())?;
        Check.equalU64(101000, await received(mut ws, mut into)? as u64)?;
        Check.isTrue((await ws.sendText("late")).isErr(), "nothing after the close")?;
    }
    Check.equalU64(1, client.stats().connections)?;
    // What went out on stream 3: the extended CONNECT, then the frames as DATA (the message, the pong, the close
    // echoed), and the stream's end.
    let wire = written(copies)?;
    let sent = sentFrames(wire.view(), true)?;
    var decoder = HpackDecoder.create(4096);
    var tunnel = Vector<u8>.create();
    var opened = false;
    var ended = false;
    for (i in 0..sent.length) {
        let f = sent[i];
        if (f.id != 3) {
            continue;
        }
        if (f.kind == 1) {
            let expected = [
                ":method", "CONNECT", ":scheme", "http", ":authority", "example.com", ":path", "/chat", ":protocol",
                "websocket", "sec-websocket-protocol", "chat", "sec-websocket-version", "13",
            ];
            expectRequest(mut decoder, wire.view(), f, expected[..])?;
            Check.equalU64(4, f.flags as u64)?; // END_HEADERS only: the stream stays open
            opened = true;
        } else if (f.kind == 0) {
            Check.isTrue(!ended, "nothing after the end")?;
            made(tunnel.extend(wire[f.start..f.end]))?;
            ended = (f.flags & 1) != 0;
        }
    }
    Check.isTrue(opened && ended, "opened, and ended")?;
    var at: usize = 0;
    var payload = Vector<u8>.create();
    Check.equalU64(0x81, clientFrame(tunnel.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes("yo".bytes(), payload.view())?;
    Check.equalU64(0x8A, clientFrame(tunnel.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes("p".bytes(), payload.view())?;
    Check.equalU64(0x88, clientFrame(tunnel.view(), mut at, mut payload)? as u64)?;
    Check.equalBytes(raw("03e8")?.view(), payload.view())?;
    Check.equalU64(tunnel.length as u64, at as u64)?;
    return Ok();
}

@test
async fn http2ConnectionsThatTakeNone() -> Result<void, TestFailure> {
    // A server that answers the CONNECT with 404: that is the answer.
    {
        let copies = made(Channel<u8>.create(8192))?;
        let client = h2Client();
        var server = Vector<u8>.create();
        h2Greeting(mut server, true)?;
        let first = server.length;
        headers(mut server, 3, "404", [], 5)?;
        scriptBytes(client, server.view(), first, 0, copies)?;
        await gotOk(client, "http://example.com/")?;
        let request = wsRequest("ws://example.com/chat")?;
        match (await client.webSocket(request, WebSocketOptions.defaults())) {
            Ok(_) => { return Check.fail("404 opens nothing"); }
            Err(e) => {
                Check.equalBytes(
                    HttpErrors.describe(HttpError.NotSwitched(404)).bytes(),
                    HttpErrors.describe(e).bytes(),
                )?;
            }
        }
        // The stream's place went back: the connection takes the next request.
        Check.equalU64(1, client.stats().connections)?;
    }
    // A server whose SETTINGS do not allow it: the WebSocket gets a connection of its own, over HTTP/1.1.
    {
        let copies = made(Channel<u8>.create(8192))?;
        let client = h2Client();
        var server = Vector<u8>.create();
        h2Greeting(mut server, false)?;
        scriptBytes(client, server.view(), 0, 0, copies)?;
        var upgraded = Vector<u8>.create();
        switching(mut upgraded, "")?;
        serverFrame(mut upgraded, 0x81, "hi".bytes())?;
        scriptBytes(client, upgraded.view(), 0, 0, copies)?;
        await gotOk(client, "http://example.com/")?;
        let request = wsRequest("ws://example.com/chat")?;
        var ws = await opened(client, request)?;
        var into = Vector<u8>.create();
        Check.equalU64(1, await received(mut ws, mut into)? as u64)?;
        Check.equalBytes("hi".bytes(), into.view())?;
        Check.equalU64(2, client.stats().connections)?;
    }
    return Ok();
}

@test
async fn anHttp2StreamTheServerEnds() -> Result<void, TestFailure> {
    // The server's close ends its side of the stream at once. The client's echo has nowhere to go; its side is
    // reset when the WebSocket is dropped, and the next request on the connection carries that out.
    let copies = made(Channel<u8>.create(8192))?;
    let client = h2Client();
    var server = Vector<u8>.create();
    h2Greeting(mut server, true)?;
    let first = server.length;
    headers(mut server, 3, "200", [], 4)?;
    // A reason that makes this part as long as the first: each is one read.
    var close = raw("03e8")?;
    made(close.resize(2 + (first - 27), '.'))?;
    var frames = Vector<u8>.create();
    serverFrame(mut frames, 0x88, close.view())?;
    frame(mut server, 0, 1, 3, frames.view())?;
    Check.equalU64((first * 2) as u64, server.length as u64)?;
    headers(mut server, 5, "200", [], 4)?;
    data(mut server, 5, "ok", true)?;
    scriptBytes(client, server.view(), first, 0, copies)?;
    await gotOk(client, "http://example.com/")?;
    {
        let request = wsRequest("ws://example.com/chat")?;
        var ws = match (await client.webSocket(request, WebSocketOptions.defaults())) {
            Ok(w) => w,
            Err(e) => { return Err(failed(e)); },
        };
        var into = Vector<u8>.create();
        Check.equalU64(101000, await received(mut ws, mut into)? as u64)?;
        Check.equalU64((first - 27) as u64, into.length as u64)?;
    }
    await gotOk(client, "http://example.com/")?;
    let wire = written(copies)?;
    let sent = sentFrames(wire.view(), true)?;
    var resets: u64 = 0;
    var bodies: u64 = 0;
    for (i in 0..sent.length) {
        if (sent[i].id == 3 && sent[i].kind == 3) {
            resets += 1;
            Check.equalU64(8, wire.readBE<u32>(sent[i].start) as u64)?; // CANCEL
        } else if (sent[i].id == 3 && sent[i].kind == 0) {
            bodies += 1;
        }
    }
    Check.equalU64(1, resets)?;
    Check.equalU64(0, bodies)?;
    return Ok();
}
