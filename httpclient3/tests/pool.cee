// httpclient's Client speaking HTTP/3 through the pool, against the server of h3.cee.
import web_core;
import web_tls;
import web_quic;
import httpclient;

fn urlFor(port: u16, path: StringView) -> Result<String, TestFailure> {
    var url = String.create();
    let built = url.append("https://localhost:").isOk() && url.appendNumber(port as u64).isOk() && url.append(path).isOk();
    if (!built) {
        return Err(TestFailure.create("out of memory"));
    }
    return Ok(url);
}

async fn fetched(client: borrow Client, port: u16, path: StringView, status: u64, body: StringView) -> Result<void, TestFailure> {
    let url = urlFor(port, path)?;
    let response = match (await client.get(url.view())) {
        Ok(r) => r,
        Err(e) => { return Err(failed(e)); },
    };
    Check.isTrue(response.isHttp3(), "over HTTP/3")?;
    Check.equalU64(status, response.status() as u64)?;
    return Check.equalBytes(body.bytes(), response.body());
}

/// A WebSocket is a stream of the HTTP/3 connection the client already has: no other connection is made.
async fn socketsThroughTheClient(client: borrow Client, port: u16) -> Result<void, TestFailure> {
    let before = client.stats().connections;
    var url = String.create();
    let built = url.append("wss://localhost:").isOk() && url.appendNumber(port as u64).isOk() && url.append("/ws").isOk();
    Check.isTrue(built, "the URL")?;
    let request = match (Request.create(Method.Get, url.view())) {
        Ok(r) => r,
        Err(e) => { return Err(failed(e)); },
    };
    {
        var ws = match (await client.webSocket(request, WebSocketOptions.defaults())) {
            Ok(w) => w,
            Err(e) => { return Err(failed(e)); },
        };
        var into = Vector<u8>.create();
        Check.isTrue((await ws.sendText("hello")).isOk(), "a text message")?;
        match (await ws.receive(mut into)) {
            Ok(Message.Text) => { Check.equalBytes("hello".bytes(), into.view())?; }
            Ok(_) => { return Check.fail("a text message comes back"); }
            Err(e) => { return Err(failed(e)); }
        }
        // More than the stream's first window both ways, with a ping on the way whose pong is dropped.
        var large = Vector<u8>.create();
        for (i in 0..1500000) {
            if (large.push(pattern(i)).isErr()) {
                return Err(TestFailure.create("out of memory"));
            }
        }
        Check.isTrue((await ws.ping("p".bytes())).isOk(), "a ping")?;
        match (await ws.sendBinary(large.view())) {
            Ok() => {}
            Err(e) => { return Err(failed(e)); }
        }
        match (await ws.receive(mut into)) {
            Ok(Message.Binary) => { Check.equalBytes(large.view(), into.view())?; }
            Ok(_) => { return Check.fail("a binary message comes back"); }
            Err(e) => { return Err(failed(e)); }
        }
        Check.isTrue((await ws.close(1000, "bye")).isOk(), "the close")?;
        match (await ws.receive(mut into)) {
            Ok(Message.Close(code)) => {
                Check.equalU64(1000, code as u64)?;
                Check.equalBytes("bye".bytes(), into.view())?;
            }
            Ok(_) => { return Check.fail("the close comes back"); }
            Err(e) => { return Err(failed(e)); }
        }
    }
    // One given up without a close: its stream is cancelled, and the connection goes on.
    {
        var ws = match (await client.webSocket(request, WebSocketOptions.defaults())) {
            Ok(w) => w,
            Err(e) => { return Err(failed(e)); },
        };
        Check.isTrue((await ws.sendText("unanswered")).isOk(), "a message")?;
    }
    // A server that answers the CONNECT with 403.
    var elsewhere = String.create();
    let made = elsewhere.append("wss://localhost:").isOk() && elsewhere.appendNumber(port as u64).isOk() &&
        elsewhere.append("/nowhere").isOk();
    Check.isTrue(made, "the URL")?;
    let refused = match (Request.create(Method.Get, elsewhere.view())) {
        Ok(r) => r,
        Err(e) => { return Err(failed(e)); },
    };
    match (await client.webSocket(refused, WebSocketOptions.defaults())) {
        Ok(_) => { return Check.fail("403 opens nothing"); }
        Err(e) => {
            Check.equalBytes(HttpErrors.describe(HttpError.NotSwitched(403)).bytes(), HttpErrors.describe(e).bytes())?;
        }
    }
    Check.equalU64(before, client.stats().connections)?;
    return await fetched(client, port, "/hello", 200, "hello over h3");
}

async fn throughTheClient(client: borrow Client, port: u16, silent: u16) -> Result<void, TestFailure> {
    await fetched(client, port, "/hello", 200, "hello over h3")?;
    // The client's own work happens above the transport: a redirect is followed, over HTTP/3 again.
    await fetched(client, port, "/moved", 200, "hello over h3")?;
    await fetched(client, port, "/missing", 404, "")?;
    await Async.scope(TestFailure.create("out of memory"), (s) => {
        s.spawn(async () => await fetched(client, port, "/hello", 200, "hello over h3"));
        s.spawn(async () => await fetched(client, port, "/split", 200, "abcd"));
        s.spawn(async () => await fetched(client, port, "/interim", 200, "final"));
        s.spawn(async () => await fetched(client, port, "/moved", 200, "hello over h3"));
        s.spawn(async () => await fetched(client, port, "/nothing", 204, ""));
    })?;
    let stats = client.stats();
    Check.equalU64(10, stats.overHttp3)?; // each redirect is two
    // A streamed response, three megabytes read through the client; then one dropped half read.
    {
        let url = urlFor(port, "/big")?;
        let request = match (Request.create(Method.Get, url.view())) {
            Ok(r) => r,
            Err(e) => { return Err(failed(e)); },
        };
        var response = match (await client.open(request, "".bytes())) {
            Ok(r) => r,
            Err(e) => { return Err(failed(e)); },
        };
        Check.isTrue(response.isHttp3() && !response.isComplete(), "streamed over HTTP/3")?;
        var piece = [0u8; 20000];
        var total: usize = 0;
        var good = true;
        loop {
            let n = match (await response.read(mut piece[..])) {
                Ok(n) => n,
                Err(e) => { return Err(failed(e)); },
            };
            if (n == 0) {
                break;
            }
            for (i in 0..n) {
                if (piece[i] != pattern(total + i)) {
                    good = false;
                }
            }
            total += n;
        }
        Check.equalU64(3145728, total as u64)?;
        Check.isTrue(good && response.isComplete(), "the streamed body, to its end")?;
        var half = match (await client.open(request, "".bytes())) {
            Ok(r) => r,
            Err(e) => { return Err(failed(e)); },
        };
        let n = match (await half.read(mut piece[..])) {
            Ok(n) => n,
            Err(e) => { return Err(failed(e)); },
        };
        Check.isTrue(n > 0, "some of it")?;
    }
    await fetched(client, port, "/hello", 200, "hello over h3")?;
    Check.equalU64(0, stats.connections)?; // no TCP connection was opened
    // An upload of two and a half megabytes with its length, more than QUIC holds at once, so the writer waits
    // for the path; then one without a length, and one given up.
    {
        let url = urlFor(port, "/sum")?;
        let request = match (Request.create(Method.Post, url.view())) {
            Ok(r) => r,
            Err(e) => { return Err(failed(e)); },
        };
        var upload = match (await client.upload(request, Some(2500000))) {
            Ok(u) => u,
            Err(e) => { return Err(failed(e)); },
        };
        var piece = Vector<u8>.create();
        var sent: usize = 0;
        var sum: u64 = 0;
        while (sent < 2500000) {
            piece.clear();
            while (piece.length < 70000 && sent + piece.length < 2500000) {
                let b = pattern(sent + piece.length);
                sum += b as u64;
                if (piece.push(b).isErr()) {
                    return Err(TestFailure.create("out of memory"));
                }
            }
            match (await upload.write(piece.view())) {
                Ok() => {}
                Err(e) => { return Err(failed(e)); }
            }
            sent += piece.length;
        }
        let response = match (await upload.finish()) {
            Ok(r) => r,
            Err(e) => { return Err(failed(e)); },
        };
        var expected = String.create();
        let built = expected.appendNumber(2500000).isOk() && expected.append(" ").isOk() && expected.appendNumber(sum).isOk();
        Check.isTrue(built && response.isHttp3(), "an upload over HTTP/3")?;
        Check.equalU64(200, response.status() as u64)?;
        Check.equalBytes(expected.view().bytes(), response.body())?;
        match (response.header("x-declared")) {
            Some(v) => { Check.equalBytes("2500000".bytes(), v)?; }
            null => { return Check.fail("the declared length"); }
        }

        var open = match (await client.upload(request, null)) {
            Ok(u) => u,
            Err(e) => { return Err(failed(e)); },
        };
        Check.isTrue((await open.write("ab".bytes())).isOk() && (await open.write("c".bytes())).isOk(), "two pieces")?;
        let counted = match (await open.finish()) {
            Ok(r) => r,
            Err(e) => { return Err(failed(e)); },
        };
        Check.equalBytes("3 294".bytes(), counted.body())?; // 97 + 98 + 99
        match (counted.header("x-declared")) {
            Some(v) => { Check.equalBytes("".bytes(), v)?; }
            null => { return Check.fail("no declared length"); }
        }

        var given = match (await client.upload(request, Some(10))) {
            Ok(u) => u,
            Err(e) => { return Err(failed(e)); },
        };
        Check.isTrue((await given.write("half".bytes())).isOk(), "a piece of what was promised")?;
    }
    await fetched(client, port, "/hello", 200, "hello over h3")?;
    await socketsThroughTheClient(client, port)?;
    // A server that does not answer on UDP: found out within the handshake's time, then TCP is tried (nothing
    // listens there either), and the origin is left alone.
    let started = Timer.now();
    let url = urlFor(silent, "/hello")?;
    Check.isTrue((await client.get(url.view())).isErr(), "nobody answers")?;
    Check.isTrue(Timer.now() - started < 5000, "found out soon")?;
    let again = Timer.now();
    Check.isTrue((await client.get(url.view())).isErr(), "nobody answers, again")?;
    Check.isTrue(Timer.now() - again < 200, "HTTP/3 was not tried a second time")?;
    // The first server is unharmed.
    await fetched(client, port, "/hello", 200, "hello over h3")?;
    return Ok();
}

@test
async fn theClientOverHttp3() -> Result<void, TestFailure> {
    Check.isTrue(QuicLibrary.initialise(), "the QUIC library")?;
    let p = configs()?;
    let any = SocketAddress.V4([127u8, 0, 0, 1], 0);
    let socket = match (AsyncUdpSocket.bind(any, UdpOptions.defaults())) {
        Ok(s) => s,
        Err(_) => { return Err(TestFailure.create("the server's socket")); },
    };
    let local = match (socket.localAddress()) {
        Ok(a) => a,
        Err(_) => { return Err(TestFailure.create("the server's address")); },
    };
    // A socket nobody reads: a server that is not there.
    let quiet = match (AsyncUdpSocket.bind(any, UdpOptions.defaults())) {
        Ok(s) => s,
        Err(_) => { return Err(TestFailure.create("the silent socket")); },
    };
    let silent = match (quiet.localAddress()) {
        Ok(SocketAddress.V4(_, port)) => port,
        _ => { return Err(TestFailure.create("the silent address")); },
    };
    let port = match (local) {
        SocketAddress.V4(_, n) => n,
        _ => { return Err(TestFailure.create("the server's port")); },
    };
    let tls = match (Arc<QuicTls>.create(p.server)) {
        Ok(t) => t,
        Err(_) => { return Err(TestFailure.create("out of memory")); },
    };
    let boxed: Box<dyn QuicApplication + Send + Share> = match (Box.create(Responder { tunnels: true })) {
        Ok(b) => b,
        Err(_) => { return Err(TestFailure.create("out of memory")); },
    };
    let app = match (Arc<Box<dyn QuicApplication + Send + Share>>.create(boxed)) {
        Ok(a) => a,
        Err(_) => { return Err(TestFailure.create("out of memory")); },
    };
    var h3 = H3Options.defaults();
    h3.handshakeMs = 400;
    let pool = match (Http3Pool.create(p.client, h3, 2)) {
        Ok(q) => q,
        Err(e) => { return Err(failed(e)); },
    };
    let transport: Box<dyn Http3Transport> = match (Box.create(pool)) {
        Ok(b) => b,
        Err(_) => { return Err(TestFailure.create("out of memory")); },
    };
    var options = ClientOptions.defaults();
    options.http3PriorKnowledge = true;
    options.connectMs = 1000;
    options.maxRedirects = 5;
    let client = Client.withHttp3(options, p.clientConfig, transport);
    let raced: Result<Raced<Ended>, AsyncError> = await Async.race(
        async move () => {
            let _ = await QuicServer.serve(socket, local, tls, app, QuicServerOptions.defaults());
            return Ok(Ended.Server);
        },
        async () => {
            match (await throughTheClient(client, port, silent)) {
                Ok() => { return Ok(Ended.Client); }
                Err(e) => { return Ok(Ended.ClientFailed(e)); }
            }
        },
    );
    return match (raced) {
        Ok(won) => match (won.value) {
            Ended.Client => Ok(),
            Ended.ClientFailed(e) => Err(e),
            Ended.Server => Err(TestFailure.create("the server ended before the client")),
        },
        Err(_) => Err(TestFailure.create("the race")),
    };
}
